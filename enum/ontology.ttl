###  https://dev.qaecy.com/enum#BackupFileContent
:BackupFileContent rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ,
                            <https://dev.qaecy.com/ont#MimeCategory> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Content of a backup file holding a copy of other data."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Backup File Content"@en .


###  https://dev.qaecy.com/enum#Balcony
:Balcony rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  <https://dev.qaecy.com/ont#EntityCategory> ;
         <http://www.w3.org/2004/02/skos/core#broader> :BuildingElement ;
         <http://www.w3.org/2004/02/skos/core#definition> "A platform projecting from a building wall, enclosed by a railing or balustrade."@en ,
                                                          "Eine von einer Gebäudewand auskragende Plattform, die durch ein Geländer begrenzt ist."@de ,
                                                          "En platform, der rager ud fra en bygningsvæg og er afgrænset af et værn."@da ,
                                                          "Una piattaforma che sporge da una parete dell'edificio, delimitata da una ringhiera."@it ,
                                                          "Une plateforme en saillie d'un mur de bâtiment, délimitée par un garde-corps."@fr ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Balcony"@da ,
                                                         "Balcony"@de ,
                                                         "Balcony"@en ,
                                                         "Balcony"@fr ,
                                                         "Balcony"@it ;
         <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                                 :DesignDocument ;
         <https://dev.qaecy.com/ont#relatedFormalClass> <https://w3id.org/rec#Balcony> .


###  https://dev.qaecy.com/enum#Beam
:Beam rdf:type owl:NamedIndividual ,
               <http://www.w3.org/2004/02/skos/core#Concept> ,
               <https://dev.qaecy.com/ont#EntityCategory> ;
      <http://www.w3.org/2004/02/skos/core#broader> :BuildingElement ;
      <http://www.w3.org/2004/02/skos/core#definition> "A horizontal structural element that carries loads across a span."@en ,
                                                       "Ein horizontales Tragelement, das Lasten über eine Spannweite trägt."@de ,
                                                       "Et vandret bærende element, der bærer laster over et spænd."@da ,
                                                       "Un elemento strutturale orizzontale che sostiene i carichi su una luce."@it ,
                                                       "Un élément structurel horizontal qui supporte les charges sur une portée."@fr ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Beam"@da ,
                                                      "Beam"@de ,
                                                      "Beam"@en ,
                                                      "Beam"@fr ,
                                                      "Beam"@it ;
      <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                              :DesignDocument ;
      <https://dev.qaecy.com/ont#relatedFormalClass> <https://w3id.org/beo#Beam> .


###  https://dev.qaecy.com/enum#BinaryFileContent
:BinaryFileContent rdf:type owl:NamedIndividual ,
