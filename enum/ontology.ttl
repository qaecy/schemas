###  https://dev.qaecy.com/enum#AWS
:AWS rdf:type owl:NamedIndividual ,
              <http://www.w3.org/2004/02/skos/core#Concept> ,
              <https://dev.qaecy.com/ont#ProviderType> ;
     <http://www.w3.org/2004/02/skos/core#definition> "A cloud infrastructure provider, denoting resources hosted on Amazon Web Services."@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Amazon Web Services"@en .


###  https://dev.qaecy.com/enum#Activity
:Activity rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                   <https://dev.qaecy.com/ont#EntityCategory> ;
          <http://www.w3.org/2004/02/skos/core#definition> "A task or process carried out as part of the construction, operation or maintenance of a built asset."@en ,
                                                           "Eine Aufgabe oder ein Vorgang im Rahmen von Bau, Betrieb oder Instandhaltung einer baulichen Anlage."@de ,
                                                           "En opgave eller proces, der udføres som led i opførelse, drift eller vedligeholdelse af et bygget aktiv."@da ,
                                                           "Un'attività o un processo svolto nell'ambito della costruzione, del funzionamento o della manutenzione di un bene edilizio."@it ,
                                                           "Une tâche ou un processus réalisé dans le cadre de la construction, de l'exploitation ou de la maintenance d'un actif bâti."@fr ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Activity"@en ,
                                                          "Activité"@fr ,
                                                          "Aktivitet"@da ,
                                                          "Aktivität"@de ,
                                                          "Attività"@it ;
          <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ;
          <https://dev.qaecy.com/ont#extractionPrompt> "An activity or process related to the construction or maintenance of a building or infrastructure."@en .


###  https://dev.qaecy.com/enum#Address
:Address rdf:type owl:NamedIndividual ,
                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                  <https://dev.qaecy.com/ont#EntityCategory> ;
         <http://www.w3.org/2004/02/skos/core#broader> :Location ;
         <http://www.w3.org/2004/02/skos/core#definition> "A postal address identifying the location of a building, site or organization."@en ,
                                                          "Eine Postanschrift, die den Standort eines Gebäudes, Geländes oder einer Organisation angibt."@de ,
                                                          "En postadresse, der angiver placeringen af en bygning, et sted eller en organisation."@da ,
                                                          "Un indirizzo postale che identifica la posizione di un edificio, un sito o un'organizzazione."@it ,
                                                          "Une adresse postale identifiant l'emplacement d'un bâtiment, d'un site ou d'une organisation."@fr ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Address"@en ,
                                                         "Adresse"@da ,
                                                         "Adresse"@de ,
                                                         "Adresse"@fr ,
                                                         "Indirizzo"@it .


###  https://dev.qaecy.com/enum#AppraisalValuationDocument
:AppraisalValuationDocument rdf:type owl:NamedIndividual ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ,
                                     <https://dev.qaecy.com/ont#ContentCategory> ;
                            <http://www.w3.org/2004/02/skos/core#broader> :FinancialAdministrativeDocument ;
                            <http://www.w3.org/2004/02/skos/core#definition> "An appraisal or valuation of a property or asset."@en ,
                                                                             "Eine Begutachtung oder Bewertung einer Immobilie oder eines Vermögenswerts."@de ,
                                                                             "En vurdering eller værdiansættelse af en ejendom eller et aktiv."@da ,
                                                                             "Una perizia o valutazione di un immobile o di un bene."@it ,
                                                                             "Une expertise ou une évaluation d'un bien ou d'un actif."@fr ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Appraisal or Valuation Document"@da ,
                                                                            "Appraisal or Valuation Document"@de ,
                                                                            "Appraisal or Valuation Document"@en ,
                                                                            "Appraisal or Valuation Document"@fr ,
                                                                            "Appraisal or Valuation Document"@it .


###  https://dev.qaecy.com/enum#ArchitecturalDesignDocument
:ArchitecturalDesignDocument rdf:type owl:NamedIndividual ,
                                      <http://www.w3.org/2004/02/skos/core#Concept> ,
                                      <https://dev.qaecy.com/ont#ContentCategory> ;
                             <http://www.w3.org/2004/02/skos/core#broader> :DesignDocument ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A design document produced by the architectural discipline, such as architectural drawings or models."@en ,
                                                                              "Ein Entwurfsdokument der Disziplin Architektur, etwa Architekturzeichnungen oder Modelle."@de ,
                                                                              "Et designdokument udarbejdet af den arkitektoniske disciplin, såsom arkitekttegninger eller modeller."@da ,
                                                                              "Un document de conception produit par la discipline architecturale, tel que des plans d'architecte ou des maquettes."@fr ,
                                                                              "Un documento di progetto prodotto dalla disciplina architettonica, come disegni architettonici o modelli."@it ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Architectural Design Document"@da ,
                                                                             "Architectural Design Document"@de ,
                                                                             "Architectural Design Document"@en ,
                                                                             "Architectural Design Document"@fr ,
                                                                             "Architectural Design Document"@it .


###  https://dev.qaecy.com/enum#Architecture
:Architecture rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ,
                       <https://dev.qaecy.com/ont#EntityCategory> ;
              <http://www.w3.org/2004/02/skos/core#broader> :Discipline ;
              <http://www.w3.org/2004/02/skos/core#definition> "Den arkitektoniske disciplin, der er ansvarlig for udformningen af bygninger og deres rum."@da ,
                                                               "Die Disziplin Architektur, verantwortlich für den Entwurf von Gebäuden und ihren Räumen."@de ,
                                                               "La disciplina dell'architettura, responsabile della progettazione degli edifici e dei loro spazi."@it ,
                                                               "La discipline de l'architecture, responsable de la conception des bâtiments et de leurs espaces."@fr ,
                                                               "The architectural discipline, responsible for the design of buildings and their spaces."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Architecture"@da ,
                                                              "Architecture"@de ,
                                                              "Architecture"@en ,
                                                              "Architecture"@fr ,
                                                              "Architecture"@it ;
              <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                                      :DesignDocument .


###  https://dev.qaecy.com/enum#ArchiveFileContent
:ArchiveFileContent rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ,
                             <https://dev.qaecy.com/ont#MimeCategory> ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Content of a compressed archive file, such as ZIP or RAR."@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Archive File Content"@en .


###  https://dev.qaecy.com/enum#AsBuiltDocument
:AsBuiltDocument rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ,
                          <https://dev.qaecy.com/ont#ContentCategory> ;
                 <http://www.w3.org/2004/02/skos/core#broader> :OperationsMaintenanceDocument ;
                 <http://www.w3.org/2004/02/skos/core#definition> "A drawing or document recording the as-built condition of the works."@en ,
                                                                  "Eine Zeichnung oder ein Dokument, das den Bestandszustand der Arbeiten festhält."@de ,
                                                                  "En tegning eller et dokument, der registrerer arbejdernes som udført-tilstand."@da ,
                                                                  "Un dessin ou un document consignant l'état tel que construit des travaux."@fr ,
                                                                  "Un disegno o documento che registra lo stato as-built dei lavori."@it ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "As-Built Document"@da ,
                                                                 "As-Built Document"@de ,
                                                                 "As-Built Document"@en ,
                                                                 "As-Built Document"@fr ,
                                                                 "As-Built Document"@it .


###  https://dev.qaecy.com/enum#AudioFileContent
:AudioFileContent rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ,
                           <https://dev.qaecy.com/ont#MimeCategory> ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Content of an audio file, such as MP3 or WAV."@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Audio File Content"@en .


###  https://dev.qaecy.com/enum#AutomationFileContent
:AutomationFileContent rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ,
                                <https://dev.qaecy.com/ont#MimeCategory> ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Content of an automation or scripting file used to control software or devices."@en ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Automation File Content"@en .


