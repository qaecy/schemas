                            <https://dev.qaecy.com/ont#MimeCategory> ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Content of a generic binary file with no more specific type."@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Binary File Content"@en .


###  https://dev.qaecy.com/enum#BudgetEstimateDocument
:BudgetEstimateDocument rdf:type owl:NamedIndividual ,
                                 <http://www.w3.org/2004/02/skos/core#Concept> ,
                                 <https://dev.qaecy.com/ont#ContentCategory> ;
                        <http://www.w3.org/2004/02/skos/core#broader> :FinancialAdministrativeDocument ;
                        <http://www.w3.org/2004/02/skos/core#definition> "A budget or cost estimate for a project."@en ,
                                                                         "Ein Budget oder eine Kostenschätzung für ein Projekt."@de ,
                                                                         "Et budget eller omkostningsoverslag for et projekt."@da ,
                                                                         "Un budget o una stima dei costi per un progetto."@it ,
                                                                         "Un budget ou une estimation de coûts pour un projet."@fr ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Budget or Estimate Document"@da ,
                                                                        "Budget or Estimate Document"@de ,
                                                                        "Budget or Estimate Document"@en ,
                                                                        "Budget or Estimate Document"@fr ,
                                                                        "Budget or Estimate Document"@it .


###  https://dev.qaecy.com/enum#Building
:Building rdf:type owl:NamedIndividual ,
                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                   <https://dev.qaecy.com/ont#EntityCategory> ;
          <http://www.w3.org/2004/02/skos/core#broader> :BuildingZone ;
          <http://www.w3.org/2004/02/skos/core#definition> "A building structure within a project."@en ,
                                                           "Ein Gebäudebauwerk innerhalb eines Projekts."@de ,
                                                           "En bygningskonstruktion inden for et projekt."@da ,
                                                           "Una struttura edilizia nell'ambito di un progetto."@it ,
                                                           "Une structure de bâtiment au sein d'un projet."@fr ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Building"@en ,
                                                          "Bygning"@da ,
                                                          "Bâtiment"@fr ,
                                                          "Edificio"@it ,
                                                          "Gebäude"@de ;
          <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                                  :DesignDocument ;
          <https://dev.qaecy.com/ont#relatedFormalClass> <https://w3id.org/bot#Building> .


###  https://dev.qaecy.com/enum#BuildingAutomationSystem
:BuildingAutomationSystem rdf:type owl:NamedIndividual ,
                                   <http://www.w3.org/2004/02/skos/core#Concept> ,
                                   <https://dev.qaecy.com/ont#EntityCategory> ;
                          <http://www.w3.org/2004/02/skos/core#broader> :Discipline ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Die Disziplin Gebäudeautomation, verantwortlich für die Steuerungs- und Automationssysteme eines Gebäudes."@de ,
                                                                           "Disciplinen bygningsautomation, der er ansvarlig for en bygnings styrings- og automationssystemer."@da ,
                                                                           "La disciplina dell'automazione degli edifici, responsabile dei sistemi di controllo e automazione di un edificio."@it ,
                                                                           "La discipline de l'automatisation du bâtiment, responsable des systèmes de commande et d'automatisation d'un bâtiment."@fr ,
                                                                           "The building automation discipline, responsible for the control and automation systems of a building."@en ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Building Automation System"@en ,
                                                                          "Bygning Automation System"@da ,
                                                                          "Bâtiment Automation System"@fr ,
                                                                          "Edificio Automation System"@it ,
                                                                          "Gebäude Automation System"@de ;
                          <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                                                  :DesignDocument .


###  https://dev.qaecy.com/enum#BuildingElement
:BuildingElement rdf:type owl:NamedIndividual ,
                          <http://www.w3.org/2004/02/skos/core#Concept> ,
                          <https://dev.qaecy.com/ont#EntityCategory> ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Any tangible part of a building, such as a wall, slab, window or door."@en ,
                                                                  "Enhver håndgribelig del af en bygning, såsom en væg, et dæk, et vindue eller en dør."@da ,
                                                                  "Jeder greifbare Teil eines Gebäudes, etwa eine Wand, Decke, ein Fenster oder eine Tür."@de ,
                                                                  "Qualsiasi parte tangibile di un edificio, come un muro, un solaio, una finestra o una porta."@it ,
                                                                  "Toute partie tangible d'un bâtiment, telle qu'un mur, une dalle, une fenêtre ou une porte."@fr ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Building Element"@en ,
                                                                 "Bygning Element"@da ,
                                                                 "Bâtiment Element"@fr ,
                                                                 "Edificio Element"@it ,
                                                                 "Gebäude Element"@de ;
                 <https://dev.qaecy.com/ont#applicableContentCategories> :ConstructionProcessDocument ,
                                                                         :DesignDocument ;
                 <https://dev.qaecy.com/ont#extractionPrompt> "Any tangible part of a 'Building', identified by a name or an id."@en ;
                 <https://dev.qaecy.com/ont#relatedFormalClass> <https://w3id.org/bot#Element> ,
                                                                <https://w3id.org/rec#BuildingElement> .


###  https://dev.qaecy.com/enum#BuildingStoreyInterface
:BuildingStoreyInterface rdf:type owl:NamedIndividual ,
                                  <http://www.w3.org/2004/02/skos/core#Concept> ,
                                  <https://dev.qaecy.com/ont#EntityCategory> ;
                         <http://www.w3.org/2004/02/skos/core#broader> :Interface ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Die Beziehung zwischen einem Gebäude und einem seiner Geschosse."@de ,
                                                                          "Forholdet mellem en bygning og en af dens etager."@da ,
                                                                          "La relation entre un bâtiment et l'un de ses étages."@fr ,
                                                                          "La relazione tra un edificio e uno dei suoi piani."@it ,
                                                                          "The relationship between a building and one of its storeys."@en ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Building/Storey Interface"@en ,
                                                                         "Bygning/Etage Interface"@da ,
                                                                         "Bâtiment/Étage Interface"@fr ,
                                                                         "Edificio/Piano Interface"@it ,
                                                                         "Gebäude/Geschoss Interface"@de ;
                         <https://dev.qaecy.com/ont#applicableContentCategories> :DesignDocument .


###  https://dev.qaecy.com/enum#BuildingZone
:BuildingZone rdf:type owl:NamedIndividual ,
                       <http://www.w3.org/2004/02/skos/core#Concept> ,
                       <https://dev.qaecy.com/ont#EntityCategory> ;
              <http://www.w3.org/2004/02/skos/core#definition> "A spatial subdivision of a building project, such as a site, building, storey or space."@en ,
