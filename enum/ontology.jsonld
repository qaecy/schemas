  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A sheet of a technical drawing set that contains one or more drawings, usually with a title block holding design metadata."
  }, {
    "@language" : "de",
    "@value" : "Ein Blatt eines technischen Zeichnungssatzes, das eine oder mehrere Zeichnungen enthält, meist mit einem Schriftfeld mit Entwurfsmetadaten."
  }, {
    "@language" : "da",
    "@value" : "Et ark i et teknisk tegningssæt, der indeholder en eller flere tegninger, normalt med et titelfelt med designmetadata."
  }, {
    "@language" : "it",
    "@value" : "Un foglio di una serie di disegni tecnici che contiene uno o più disegni, di solito con un cartiglio contenente i metadati di progetto."
  }, {
    "@language" : "fr",
    "@value" : "Une planche d'un jeu de plans techniques contenant un ou plusieurs dessins, généralement avec un cartouche regroupant les métadonnées de conception."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Drawing Sheet"
  }, {
    "@language" : "de",
    "@value" : "Drawing Sheet"
  }, {
    "@language" : "en",
