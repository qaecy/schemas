    "@value" : "Warranty or Guarantee Document"
  }, {
    "@language" : "it",
    "@value" : "Warranty or Guarantee Document"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#Window",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
