  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A condition that must be met as part of a contractual obligation."
  }, {
    "@language" : "de",
    "@value" : "Eine Bedingung, die im Rahmen einer vertraglichen Verpflichtung erfüllt werden muss."
  }, {
    "@language" : "da",
    "@value" : "En betingelse, der skal opfyldes som led i en kontraktlig forpligtelse."
  }, {
    "@language" : "it",
    "@value" : "Una condizione che deve essere soddisfatta nell'ambito di un obbligo contrattuale."
  }, {
    "@language" : "fr",
    "@value" : "Une condition qui doit être satisfaite dans le cadre d'une obligation contractuelle."
  } ],
