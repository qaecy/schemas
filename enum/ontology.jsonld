  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A drawing showing a vertical cut through a building to reveal its internal arrangement."
  }, {
    "@language" : "de",
    "@value" : "Eine Zeichnung, die einen vertikalen Schnitt durch ein Gebäude zeigt und dessen innere Anordnung offenlegt."
  }, {
    "@language" : "da",
    "@value" : "En tegning, der viser et lodret snit gennem en bygning og afslører dens indvendige opbygning."
  }, {
    "@language" : "fr",
    "@value" : "Un dessin montrant une coupe verticale d'un bâtiment et révélant son agencement intérieur."
  }, {
    "@language" : "it",
    "@value" : "Un disegno che mostra una sezione verticale di un edificio e ne rivela la disposizione interna."
  } ],
