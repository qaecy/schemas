  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A plot of land on which one or more buildings are located."
  }, {
    "@language" : "de",
    "@value" : "Ein Grundstück, auf dem sich ein oder mehrere Gebäude befinden."
  }, {
    "@language" : "da",
    "@value" : "Et stykke jord, hvorpå en eller flere bygninger er placeret."
  }, {
    "@language" : "it",
    "@value" : "Un appezzamento di terreno su cui si trovano uno o più edifici."
  }, {
    "@language" : "fr",
    "@value" : "Une parcelle de terrain sur laquelle se trouvent un ou plusieurs bâtiments."
  } ],
