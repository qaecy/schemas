  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A warranty or guarantee covering products, systems or works."
  }, {
    "@language" : "de",
    "@value" : "Eine Garantie oder Gewährleistung für Produkte, Systeme oder Arbeiten."
  }, {
    "@language" : "da",
    "@value" : "En garanti, der dækker produkter, systemer eller arbejder."
  }, {
    "@language" : "it",
    "@value" : "Una garanzia che copre prodotti, sistemi o lavori."
  }, {
    "@language" : "fr",
    "@value" : "Une garantie couvrant des produits, des systèmes ou des travaux."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Warranty or Guarantee Document"
  }, {
    "@language" : "de",
    "@value" : "Warranty or Guarantee Document"
  }, {
