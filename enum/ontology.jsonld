  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://dev.qaecy.com/enum#Location"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A postal address identifying the location of a building, site or organization."
  }, {
    "@language" : "de",
    "@value" : "Eine Postanschrift, die den Standort eines Gebäudes, Geländes oder einer Organisation angibt."
  }, {
    "@language" : "da",
    "@value" : "En postadresse, der angiver placeringen af en bygning, et sted eller en organisation."
  }, {
    "@language" : "it",
    "@value" : "Un indirizzo postale che identifica la posizione di un edificio, un sito o un'organizzazione."
  }, {
    "@language" : "fr",
    "@value" : "Une adresse postale identifiant l'emplacement d'un bâtiment, d'un site ou d'une organisation."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Address"
  }, {
    "@language" : "da",
    "@value" : "Adresse"
  }, {
    "@language" : "de",
    "@value" : "Adresse"
  }, {
    "@language" : "fr",
    "@value" : "Adresse"
  }, {
    "@language" : "it",
    "@value" : "Indirizzo"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#AppraisalValuationDocument",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
