    "@id" : "https://dev.qaecy.com/enum#ContractualDocument"
  } ],
  "https://dev.qaecy.com/ont#extractionPrompt" : [ {
    "@language" : "en",
    "@value" : "A certain obligation that must be undertaken in the context of the 'Contract'."
  } ]
}, {
