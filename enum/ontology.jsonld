    "@id" : "https://dev.qaecy.com/enum#FinancialAdministrativeDocument"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An appraisal or valuation of a property or asset."
  }, {
    "@language" : "de",
    "@value" : "Eine Begutachtung oder Bewertung einer Immobilie oder eines Vermögenswerts."
  }, {
    "@language" : "da",
    "@value" : "En vurdering eller værdiansættelse af en ejendom eller et aktiv."
  }, {
    "@language" : "it",
    "@value" : "Una perizia o valutazione di un immobile o di un bene."
  }, {
    "@language" : "fr",
    "@value" : "Une expertise ou une évaluation d'un bien ou d'un actif."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Appraisal or Valuation Document"
  }, {
    "@language" : "de",
    "@value" : "Appraisal or Valuation Document"
  }, {
    "@language" : "en",
    "@value" : "Appraisal or Valuation Document"
  }, {
    "@language" : "fr",
    "@value" : "Appraisal or Valuation Document"
  }, {
    "@language" : "it",
    "@value" : "Appraisal or Valuation Document"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#ArchitecturalDesignDocument",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#ContentCategory"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://dev.qaecy.com/enum#DesignDocument"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A design document produced by the architectural discipline, such as architectural drawings or models."
  }, {
    "@language" : "de",
    "@value" : "Ein Entwurfsdokument der Disziplin Architektur, etwa Architekturzeichnungen oder Modelle."
  }, {
    "@language" : "da",
    "@value" : "Et designdokument udarbejdet af den arkitektoniske disciplin, såsom arkitekttegninger eller modeller."
  }, {
    "@language" : "fr",
    "@value" : "Un document de conception produit par la discipline architecturale, tel que des plans d'architecte ou des maquettes."
  }, {
    "@language" : "it",
    "@value" : "Un documento di progetto prodotto dalla disciplina architettonica, come disegni architettonici o modelli."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Architectural Design Document"
  }, {
    "@language" : "de",
    "@value" : "Architectural Design Document"
  }, {
    "@language" : "en",
    "@value" : "Architectural Design Document"
  }, {
    "@language" : "fr",
    "@value" : "Architectural Design Document"
  }, {
    "@language" : "it",
    "@value" : "Architectural Design Document"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#Architecture",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityCategory"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://dev.qaecy.com/enum#Discipline"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "da",
    "@value" : "Den arkitektoniske disciplin, der er ansvarlig for udformningen af bygninger og deres rum."
  }, {
    "@language" : "de",
    "@value" : "Die Disziplin Architektur, verantwortlich für den Entwurf von Gebäuden und ihren Räumen."
  }, {
    "@language" : "it",
    "@value" : "La disciplina dell'architettura, responsabile della progettazione degli edifici e dei loro spazi."
  }, {
    "@language" : "fr",
    "@value" : "La discipline de l'architecture, responsable de la conception des bâtiments et de leurs espaces."
  }, {
    "@language" : "en",
    "@value" : "The architectural discipline, responsible for the design of buildings and their spaces."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Architecture"
  }, {
    "@language" : "de",
    "@value" : "Architecture"
  }, {
    "@language" : "en",
    "@value" : "Architecture"
  }, {
    "@language" : "fr",
    "@value" : "Architecture"
  }, {
    "@language" : "it",
    "@value" : "Architecture"
  } ],
