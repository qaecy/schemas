  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An individual drawing such as a floor plan, section, elevation or diagram, usually placed on a drawing sheet."
  }, {
    "@language" : "de",
    "@value" : "Eine einzelne Zeichnung wie ein Grundriss, Schnitt, Aufriss oder Diagramm, die meist auf einem Zeichnungsblatt platziert ist."
  }, {
    "@language" : "da",
    "@value" : "En enkelt tegning såsom en plantegning, et snit, en facade eller et diagram, normalt placeret på et tegningsark."
  }, {
    "@language" : "fr",
    "@value" : "Un dessin individuel tel qu'un plan, une coupe, une élévation ou un schéma, généralement placé sur une planche de dessin."
  }, {
    "@language" : "it",
    "@value" : "Un singolo disegno come una pianta, una sezione, un prospetto o uno schema, di solito collocato su un foglio di disegno."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Drawing Entity"
  }, {
    "@language" : "de",
    "@value" : "Drawing Entity"
  }, {
    "@language" : "en",
    "@value" : "Drawing Entity"
  }, {
    "@language" : "fr",
