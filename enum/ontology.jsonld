  }, {
    "@id" : "https://dev.qaecy.com/enum#DesignDocument"
  } ],
  "https://dev.qaecy.com/ont#extractionPrompt" : [ {
    "@language" : "en",
    "@value" : "Any drawing (floor-plan, site-plan, section, P&ID diagram, detail etc), identified by name, title or id. Usually, but not necessarily, it is contained in a 'DrawingSheet'."
  } ]
}, {
