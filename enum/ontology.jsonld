  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A platform projecting from a building wall, enclosed by a railing or balustrade."
  }, {
    "@language" : "de",
    "@value" : "Eine von einer Gebäudewand auskragende Plattform, die durch ein Geländer begrenzt ist."
  }, {
    "@language" : "da",
    "@value" : "En platform, der rager ud fra en bygningsvæg og er afgrænset af et værn."
  }, {
    "@language" : "it",
    "@value" : "Una piattaforma che sporge da una parete dell'edificio, delimitata da una ringhiera."
  }, {
    "@language" : "fr",
    "@value" : "Une plateforme en saillie d'un mur de bâtiment, délimitée par un garde-corps."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Balcony"
  }, {
    "@language" : "de",
    "@value" : "Balcony"
  }, {
    "@language" : "en",
    "@value" : "Balcony"
  }, {
    "@language" : "fr",
    "@value" : "Balcony"
  }, {
    "@language" : "it",
    "@value" : "Balcony"
  } ],
