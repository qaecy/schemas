    "@id" : "https://w3id.org/rec#Balcony"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#Beam",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityCategory"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://dev.qaecy.com/enum#BuildingElement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A horizontal structural element that carries loads across a span."
  }, {
    "@language" : "de",
    "@value" : "Ein horizontales Tragelement, das Lasten über eine Spannweite trägt."
