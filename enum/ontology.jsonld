}, {
  "@id" : "https://dev.qaecy.com/enum#Discipline",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityCategory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A professional discipline or trade responsible for part of a project's design, construction or operation."
  }, {
    "@language" : "de",
    "@value" : "Eine Fachdisziplin oder ein Gewerk, das für einen Teil der Planung, des Baus oder Betriebs eines Projekts verantwortlich ist."
  }, {
    "@language" : "da",
    "@value" : "En faglig disciplin eller et fag, der er ansvarlig for en del af et projekts projektering, opførelse eller drift."
  }, {
    "@language" : "it",
    "@value" : "Una disciplina professionale o un mestiere responsabile di una parte della progettazione, della costruzione o della gestione di un progetto."
  }, {
    "@language" : "fr",
    "@value" : "Une discipline professionnelle ou un corps de métier responsable d'une partie de la conception, de la construction ou de l'exploitation d'un projet."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Disciplin"
  }, {
