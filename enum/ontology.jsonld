  } ],
  "https://dev.qaecy.com/ont#extractionPrompt" : [ {
    "@language" : "en",
    "@value" : "A sheet of a technical drawing, that contains one or more 'DrawingEntity'. Most often contains a title block with 'DesignMetadata'. It is identified by name, title or id."
  } ]
