}, {
  "@id" : "https://dev.qaecy.com/enum#AWS",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#ProviderType"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A cloud infrastructure provider, denoting resources hosted on Amazon Web Services."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Amazon Web Services"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#Activity",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityCategory"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A task or process carried out as part of the construction, operation or maintenance of a built asset."
  }, {
    "@language" : "de",
    "@value" : "Eine Aufgabe oder ein Vorgang im Rahmen von Bau, Betrieb oder Instandhaltung einer baulichen Anlage."
  }, {
    "@language" : "da",
    "@value" : "En opgave eller proces, der udføres som led i opførelse, drift eller vedligeholdelse af et bygget aktiv."
  }, {
    "@language" : "it",
    "@value" : "Un'attività o un processo svolto nell'ambito della costruzione, del funzionamento o della manutenzione di un bene edilizio."
  }, {
    "@language" : "fr",
    "@value" : "Une tâche ou un processus réalisé dans le cadre de la construction, de l'exploitation ou de la maintenance d'un actif bâti."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "en",
    "@value" : "Activity"
  }, {
    "@language" : "fr",
    "@value" : "Activité"
  }, {
    "@language" : "da",
    "@value" : "Aktivitet"
  }, {
    "@language" : "de",
    "@value" : "Aktivität"
  }, {
    "@language" : "it",
    "@value" : "Attività"
  } ],
  "https://dev.qaecy.com/ont#applicableContentCategories" : [ {
    "@id" : "https://dev.qaecy.com/enum#ConstructionProcessDocument"
  } ],
  "https://dev.qaecy.com/ont#extractionPrompt" : [ {
    "@language" : "en",
    "@value" : "An activity or process related to the construction or maintenance of a building or infrastructure."
  } ]
}, {
  "@id" : "https://dev.qaecy.com/enum#Address",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
