    "@id" : "https://dev.qaecy.com/enum#BuildingElement"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An opening element that admits light and air, filling a void in a wall or roof."
  }, {
    "@language" : "de",
    "@value" : "Ein Öffnungselement, das Licht und Luft einlässt und eine Öffnung in einer Wand oder einem Dach füllt."
  }, {
    "@language" : "da",
    "@value" : "Et åbningselement, der lukker lys og luft ind og udfylder et hul i en væg eller et tag."
  }, {
    "@language" : "it",
    "@value" : "Un elemento di apertura che fa entrare luce e aria, riempiendo un vuoto in una parete o in un tetto."
  }, {
    "@language" : "fr",
    "@value" : "Un élément d'ouverture qui laisse passer la lumière et l'air, comblant une ouverture dans un mur ou une toiture."
  } ],
  "http://www.w3.org/2004/02/skos/core#prefLabel" : [ {
    "@language" : "da",
    "@value" : "Window"
