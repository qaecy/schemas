        <skos:prefLabel xml:lang="fr">Operation Manual</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Operation Manual</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#OperationsMaintenanceDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#OperationsMaintenanceDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:definition xml:lang="it">Documenti per il funzionamento dell&apos;edificio, la manutenzione degli impianti, le garanzie e gli elaborati as-built.</skos:definition>
        <skos:definition xml:lang="en">Documents for building operation, system maintenance, warranties, and as-builts.</skos:definition>
        <skos:definition xml:lang="fr">Documents pour l&apos;exploitation du bâtiment, la maintenance des systèmes, les garanties et les dossiers de récolement.</skos:definition>
        <skos:definition xml:lang="de">Dokumente für Gebäudebetrieb, Anlagenwartung, Garantien und Bestandsunterlagen.</skos:definition>
        <skos:definition xml:lang="da">Dokumenter til bygningsdrift, systemvedligeholdelse, garantier og som udført-tegninger.</skos:definition>
        <skos:prefLabel xml:lang="da">Operations &amp; Maintenance Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Operations &amp; Maintenance Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Operations &amp; Maintenance Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Operations &amp; Maintenance Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Operations &amp; Maintenance Document</skos:prefLabel>
        <ont:classificationPrompt xml:lang="en">Documents for building operation, system maintenance, and lifecycle support, such as O&amp;M manuals, maintenance logs, warranty documents, commissioning reports, and as-built drawings.</ont:classificationPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#OperationsManagement -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#OperationsManagement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Discipline"/>
        <skos:definition xml:lang="de">Die Disziplin Betriebsmanagement, verantwortlich für den Betrieb einer baulichen Anlage im Gebrauch.</skos:definition>
        <skos:definition xml:lang="da">Driftsledelsesdisciplinen, der er ansvarlig for driften af et bygget aktiv i brug.</skos:definition>
        <skos:definition xml:lang="it">La disciplina della gestione operativa, responsabile del funzionamento di un bene edilizio in uso.</skos:definition>
        <skos:definition xml:lang="fr">La discipline de la gestion de l&apos;exploitation, responsable du fonctionnement d&apos;un actif bâti en service.</skos:definition>
        <skos:definition xml:lang="en">The operations management discipline, responsible for running a built asset while it is in use.</skos:definition>
        <skos:prefLabel xml:lang="da">Operations Management</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Operations Management</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Operations Management</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Operations Management</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Operations Management</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Organization -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Organization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A company, corporation, public authority, institution or other legal body that takes part in a project.</skos:definition>
        <skos:definition xml:lang="de">Ein Unternehmen, eine Körperschaft, eine Behörde, eine Institution oder eine andere juristische Person, die an einem Projekt beteiligt ist.</skos:definition>
        <skos:definition xml:lang="da">En virksomhed, koncern, offentlig myndighed, institution eller anden juridisk enhed, der deltager i et projekt.</skos:definition>
        <skos:definition xml:lang="it">Un&apos;azienda, una società, un ente pubblico, un&apos;istituzione o un&apos;altra persona giuridica che partecipa a un progetto.</skos:definition>
        <skos:definition xml:lang="fr">Une entreprise, une société, une autorité publique, une institution ou une autre personne morale participant à un projet.</skos:definition>
        <skos:prefLabel xml:lang="da">Organisation</skos:prefLabel>
