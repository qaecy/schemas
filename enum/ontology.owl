        <skos:prefLabel xml:lang="fr">Organisation</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Organization</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Organizzazione</skos:prefLabel>
        <ont:extractionPrompt xml:lang="en">A company, organization, corporation, public authority or institution, identified by name or title.</ont:extractionPrompt>
        <ont:relatedFormalClass rdf:resource="http://schema.org/Organization"/>
    </owl:NamedIndividual>
    


