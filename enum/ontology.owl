    <!-- https://dev.qaecy.com/enum#Site -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Site">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
