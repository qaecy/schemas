        <skos:prefLabel xml:lang="de">Datum</skos:prefLabel>
        <ont:extractionPrompt xml:lang="en">A date. Must be returned in ISO 8601 **YYYY-MM-DD** format (eg: 4/5/2005 becomes 2005-05-04, 1 July 2021 becomes 2021-07-01 etc).</ont:extractionPrompt>
        <ont:regex>^[0-9]{4}-[0-9]{2}-[0-9]{2}$</ont:regex>
    </owl:NamedIndividual>
    


