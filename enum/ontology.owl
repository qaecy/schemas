    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Roof -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Roof">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
