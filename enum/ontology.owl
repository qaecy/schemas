        <skos:definition xml:lang="fr">Un code, une classification ou un identifiant attribué à un objet physique ou virtuel utilisé dans un projet de construction.</skos:definition>
        <skos:definition xml:lang="it">Un codice, una classificazione o un identificatore assegnato a un oggetto fisico o virtuale utilizzato in un progetto edilizio.</skos:definition>
        <skos:prefLabel xml:lang="da">Object Id</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Object Id</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Object Id</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Object Id</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Object Id</skos:prefLabel>
        <ont:extractionPrompt xml:lang="en">A special coding, classification or identifier for some physical or virtual object used in a building project.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#OpeningElementInterface -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#OpeningElementInterface">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Interface"/>
        <skos:definition xml:lang="de">Der Hohlraum des übergeordneten Elements, der vom untergeordneten Element gefüllt wird.</skos:definition>
        <skos:definition xml:lang="da">Det hulrum i forældreelementet, som udfyldes af barneelementet.</skos:definition>
        <skos:definition xml:lang="it">Il vuoto dell&apos;elemento padre che viene riempito dall&apos;elemento figlio.</skos:definition>
        <skos:definition xml:lang="fr">Le vide de l&apos;élément parent qui est comblé par l&apos;élément enfant.</skos:definition>
        <skos:definition xml:lang="en">The void of the parent element which is filled by the child element</skos:definition>
        <skos:prefLabel xml:lang="da">Opening Element Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Opening Element Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Opening Element Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Opening Element Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Opening Element Interface</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#OperationManual -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#OperationManual">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
