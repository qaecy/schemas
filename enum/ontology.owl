        <skos:definition xml:lang="da">Dokumenter, der fastlægger omfang samt funktionelle, tekniske og ydelsesmæssige krav.</skos:definition>
        <skos:prefLabel xml:lang="da">Requirements &amp; Scoping Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Requirements &amp; Scoping Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Requirements &amp; Scoping Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Requirements &amp; Scoping Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Requirements &amp; Scoping Document</skos:prefLabel>
