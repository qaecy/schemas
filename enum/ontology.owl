        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/bot#Site"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#SiteBuildingInterface -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#SiteBuildingInterface">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
