        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <skos:definition xml:lang="en">An opening element that admits light and air, filling a void in a wall or roof.</skos:definition>
        <skos:definition xml:lang="de">Ein Öffnungselement, das Licht und Luft einlässt und eine Öffnung in einer Wand oder einem Dach füllt.</skos:definition>
        <skos:definition xml:lang="da">Et åbningselement, der lukker lys og luft ind og udfylder et hul i en væg eller et tag.</skos:definition>
        <skos:definition xml:lang="it">Un elemento di apertura che fa entrare luce e aria, riempiendo un vuoto in una parete o in un tetto.</skos:definition>
        <skos:definition xml:lang="fr">Un élément d&apos;ouverture qui laisse passer la lumière et l&apos;air, comblant une ouverture dans un mur ou une toiture.</skos:definition>
