    <!-- https://dev.qaecy.com/enum#AWS -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#AWS">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ProviderType"/>
        <skos:definition xml:lang="en">A cloud infrastructure provider, denoting resources hosted on Amazon Web Services.</skos:definition>
        <skos:prefLabel xml:lang="en">Amazon Web Services</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Activity -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Activity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A task or process carried out as part of the construction, operation or maintenance of a built asset.</skos:definition>
        <skos:definition xml:lang="de">Eine Aufgabe oder ein Vorgang im Rahmen von Bau, Betrieb oder Instandhaltung einer baulichen Anlage.</skos:definition>
        <skos:definition xml:lang="da">En opgave eller proces, der udføres som led i opførelse, drift eller vedligeholdelse af et bygget aktiv.</skos:definition>
        <skos:definition xml:lang="it">Un&apos;attività o un processo svolto nell&apos;ambito della costruzione, del funzionamento o della manutenzione di un bene edilizio.</skos:definition>
        <skos:definition xml:lang="fr">Une tâche ou un processus réalisé dans le cadre de la construction, de l&apos;exploitation ou de la maintenance d&apos;un actif bâti.</skos:definition>
        <skos:prefLabel xml:lang="en">Activity</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Activité</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Aktivitet</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Aktivität</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Attività</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:extractionPrompt xml:lang="en">An activity or process related to the construction or maintenance of a building or infrastructure.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Address -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Address">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Location"/>
        <skos:definition xml:lang="en">A postal address identifying the location of a building, site or organization.</skos:definition>
        <skos:definition xml:lang="de">Eine Postanschrift, die den Standort eines Gebäudes, Geländes oder einer Organisation angibt.</skos:definition>
        <skos:definition xml:lang="da">En postadresse, der angiver placeringen af en bygning, et sted eller en organisation.</skos:definition>
        <skos:definition xml:lang="it">Un indirizzo postale che identifica la posizione di un edificio, un sito o un&apos;organizzazione.</skos:definition>
        <skos:definition xml:lang="fr">Une adresse postale identifiant l&apos;emplacement d&apos;un bâtiment, d&apos;un site ou d&apos;une organisation.</skos:definition>
        <skos:prefLabel xml:lang="en">Address</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Adresse</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Adresse</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Adresse</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Indirizzo</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#AppraisalValuationDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#AppraisalValuationDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#FinancialAdministrativeDocument"/>
        <skos:definition xml:lang="en">An appraisal or valuation of a property or asset.</skos:definition>
        <skos:definition xml:lang="de">Eine Begutachtung oder Bewertung einer Immobilie oder eines Vermögenswerts.</skos:definition>
        <skos:definition xml:lang="da">En vurdering eller værdiansættelse af en ejendom eller et aktiv.</skos:definition>
        <skos:definition xml:lang="it">Una perizia o valutazione di un immobile o di un bene.</skos:definition>
        <skos:definition xml:lang="fr">Une expertise ou une évaluation d&apos;un bien ou d&apos;un actif.</skos:definition>
        <skos:prefLabel xml:lang="da">Appraisal or Valuation Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Appraisal or Valuation Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Appraisal or Valuation Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Appraisal or Valuation Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Appraisal or Valuation Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ArchitecturalDesignDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ArchitecturalDesignDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <skos:definition xml:lang="en">A design document produced by the architectural discipline, such as architectural drawings or models.</skos:definition>
        <skos:definition xml:lang="de">Ein Entwurfsdokument der Disziplin Architektur, etwa Architekturzeichnungen oder Modelle.</skos:definition>
        <skos:definition xml:lang="da">Et designdokument udarbejdet af den arkitektoniske disciplin, såsom arkitekttegninger eller modeller.</skos:definition>
        <skos:definition xml:lang="fr">Un document de conception produit par la discipline architecturale, tel que des plans d&apos;architecte ou des maquettes.</skos:definition>
        <skos:definition xml:lang="it">Un documento di progetto prodotto dalla disciplina architettonica, come disegni architettonici o modelli.</skos:definition>
        <skos:prefLabel xml:lang="da">Architectural Design Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Architectural Design Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Architectural Design Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Architectural Design Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Architectural Design Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Architecture -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Architecture">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Discipline"/>
        <skos:definition xml:lang="da">Den arkitektoniske disciplin, der er ansvarlig for udformningen af bygninger og deres rum.</skos:definition>
        <skos:definition xml:lang="de">Die Disziplin Architektur, verantwortlich für den Entwurf von Gebäuden und ihren Räumen.</skos:definition>
        <skos:definition xml:lang="it">La disciplina dell&apos;architettura, responsabile della progettazione degli edifici e dei loro spazi.</skos:definition>
        <skos:definition xml:lang="fr">La discipline de l&apos;architecture, responsable de la conception des bâtiments et de leurs espaces.</skos:definition>
        <skos:definition xml:lang="en">The architectural discipline, responsible for the design of buildings and their spaces.</skos:definition>
        <skos:prefLabel xml:lang="da">Architecture</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Architecture</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Architecture</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Architecture</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Architecture</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ArchiveFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ArchiveFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a compressed archive file, such as ZIP or RAR.</skos:definition>
        <skos:prefLabel xml:lang="en">Archive File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#AsBuiltDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#AsBuiltDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#OperationsMaintenanceDocument"/>
        <skos:definition xml:lang="en">A drawing or document recording the as-built condition of the works.</skos:definition>
        <skos:definition xml:lang="de">Eine Zeichnung oder ein Dokument, das den Bestandszustand der Arbeiten festhält.</skos:definition>
        <skos:definition xml:lang="da">En tegning eller et dokument, der registrerer arbejdernes som udført-tilstand.</skos:definition>
        <skos:definition xml:lang="fr">Un dessin ou un document consignant l&apos;état tel que construit des travaux.</skos:definition>
        <skos:definition xml:lang="it">Un disegno o documento che registra lo stato as-built dei lavori.</skos:definition>
        <skos:prefLabel xml:lang="da">As-Built Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">As-Built Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">As-Built Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">As-Built Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">As-Built Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#AudioFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#AudioFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of an audio file, such as MP3 or WAV.</skos:definition>
        <skos:prefLabel xml:lang="en">Audio File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#AutomationFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#AutomationFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of an automation or scripting file used to control software or devices.</skos:definition>
        <skos:prefLabel xml:lang="en">Automation File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Azure -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Azure">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ProviderType"/>
        <skos:definition xml:lang="en">A cloud infrastructure provider, denoting resources hosted on Microsoft Azure.</skos:definition>
        <skos:prefLabel xml:lang="en">Azure</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BIMFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BIMFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a Building Information Modelling (BIM) file, such as IFC or RVT.</skos:definition>
        <skos:prefLabel xml:lang="en">BIM File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BackupFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BackupFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a backup file holding a copy of other data.</skos:definition>
        <skos:prefLabel xml:lang="en">Backup File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Balcony -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Balcony">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <skos:definition xml:lang="en">A platform projecting from a building wall, enclosed by a railing or balustrade.</skos:definition>
        <skos:definition xml:lang="de">Eine von einer Gebäudewand auskragende Plattform, die durch ein Geländer begrenzt ist.</skos:definition>
        <skos:definition xml:lang="da">En platform, der rager ud fra en bygningsvæg og er afgrænset af et værn.</skos:definition>
        <skos:definition xml:lang="it">Una piattaforma che sporge da una parete dell&apos;edificio, delimitata da una ringhiera.</skos:definition>
        <skos:definition xml:lang="fr">Une plateforme en saillie d&apos;un mur de bâtiment, délimitée par un garde-corps.</skos:definition>
        <skos:prefLabel xml:lang="da">Balcony</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Balcony</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Balcony</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Balcony</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Balcony</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/rec#Balcony"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Beam -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Beam">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <skos:definition xml:lang="en">A horizontal structural element that carries loads across a span.</skos:definition>
        <skos:definition xml:lang="de">Ein horizontales Tragelement, das Lasten über eine Spannweite trägt.</skos:definition>
        <skos:definition xml:lang="da">Et vandret bærende element, der bærer laster over et spænd.</skos:definition>
        <skos:definition xml:lang="it">Un elemento strutturale orizzontale che sostiene i carichi su una luce.</skos:definition>
        <skos:definition xml:lang="fr">Un élément structurel horizontal qui supporte les charges sur une portée.</skos:definition>
        <skos:prefLabel xml:lang="da">Beam</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Beam</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Beam</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Beam</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Beam</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/beo#Beam"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BinaryFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BinaryFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a generic binary file with no more specific type.</skos:definition>
        <skos:prefLabel xml:lang="en">Binary File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BudgetEstimateDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BudgetEstimateDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#FinancialAdministrativeDocument"/>
        <skos:definition xml:lang="en">A budget or cost estimate for a project.</skos:definition>
        <skos:definition xml:lang="de">Ein Budget oder eine Kostenschätzung für ein Projekt.</skos:definition>
        <skos:definition xml:lang="da">Et budget eller omkostningsoverslag for et projekt.</skos:definition>
        <skos:definition xml:lang="it">Un budget o una stima dei costi per un progetto.</skos:definition>
        <skos:definition xml:lang="fr">Un budget ou une estimation de coûts pour un projet.</skos:definition>
        <skos:prefLabel xml:lang="da">Budget or Estimate Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Budget or Estimate Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Budget or Estimate Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Budget or Estimate Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Budget or Estimate Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Building -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Building">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#BuildingZone"/>
        <skos:definition xml:lang="en">A building structure within a project.</skos:definition>
        <skos:definition xml:lang="de">Ein Gebäudebauwerk innerhalb eines Projekts.</skos:definition>
        <skos:definition xml:lang="da">En bygningskonstruktion inden for et projekt.</skos:definition>
        <skos:definition xml:lang="it">Una struttura edilizia nell&apos;ambito di un progetto.</skos:definition>
        <skos:definition xml:lang="fr">Une structure de bâtiment au sein d&apos;un projet.</skos:definition>
        <skos:prefLabel xml:lang="en">Building</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Bygning</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bâtiment</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Edificio</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gebäude</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/bot#Building"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BuildingAutomationSystem -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BuildingAutomationSystem">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Discipline"/>
        <skos:definition xml:lang="de">Die Disziplin Gebäudeautomation, verantwortlich für die Steuerungs- und Automationssysteme eines Gebäudes.</skos:definition>
        <skos:definition xml:lang="da">Disciplinen bygningsautomation, der er ansvarlig for en bygnings styrings- og automationssystemer.</skos:definition>
        <skos:definition xml:lang="it">La disciplina dell&apos;automazione degli edifici, responsabile dei sistemi di controllo e automazione di un edificio.</skos:definition>
        <skos:definition xml:lang="fr">La discipline de l&apos;automatisation du bâtiment, responsable des systèmes de commande et d&apos;automatisation d&apos;un bâtiment.</skos:definition>
        <skos:definition xml:lang="en">The building automation discipline, responsible for the control and automation systems of a building.</skos:definition>
        <skos:prefLabel xml:lang="en">Building Automation System</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Bygning Automation System</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bâtiment Automation System</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Edificio Automation System</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gebäude Automation System</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BuildingElement -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BuildingElement">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">Any tangible part of a building, such as a wall, slab, window or door.</skos:definition>
        <skos:definition xml:lang="da">Enhver håndgribelig del af en bygning, såsom en væg, et dæk, et vindue eller en dør.</skos:definition>
        <skos:definition xml:lang="de">Jeder greifbare Teil eines Gebäudes, etwa eine Wand, Decke, ein Fenster oder eine Tür.</skos:definition>
        <skos:definition xml:lang="it">Qualsiasi parte tangibile di un edificio, come un muro, un solaio, una finestra o una porta.</skos:definition>
        <skos:definition xml:lang="fr">Toute partie tangible d&apos;un bâtiment, telle qu&apos;un mur, une dalle, une fenêtre ou une porte.</skos:definition>
        <skos:prefLabel xml:lang="en">Building Element</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Bygning Element</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bâtiment Element</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Edificio Element</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gebäude Element</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:extractionPrompt xml:lang="en">Any tangible part of a &apos;Building&apos;, identified by a name or an id.</ont:extractionPrompt>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/bot#Element"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/rec#BuildingElement"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BuildingStoreyInterface -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BuildingStoreyInterface">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Interface"/>
        <skos:definition xml:lang="de">Die Beziehung zwischen einem Gebäude und einem seiner Geschosse.</skos:definition>
        <skos:definition xml:lang="da">Forholdet mellem en bygning og en af dens etager.</skos:definition>
        <skos:definition xml:lang="fr">La relation entre un bâtiment et l&apos;un de ses étages.</skos:definition>
        <skos:definition xml:lang="it">La relazione tra un edificio e uno dei suoi piani.</skos:definition>
        <skos:definition xml:lang="en">The relationship between a building and one of its storeys.</skos:definition>
        <skos:prefLabel xml:lang="en">Building/Storey Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Bygning/Etage Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bâtiment/Étage Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Edificio/Piano Interface</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gebäude/Geschoss Interface</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BuildingZone -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BuildingZone">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A spatial subdivision of a building project, such as a site, building, storey or space.</skos:definition>
        <skos:definition xml:lang="de">Eine räumliche Unterteilung eines Bauprojekts, etwa ein Grundstück, Gebäude, Geschoss oder Raum.</skos:definition>
        <skos:definition xml:lang="da">En rumlig opdeling af et byggeprojekt, såsom en grund, bygning, etage eller et rum.</skos:definition>
        <skos:definition xml:lang="it">Una suddivisione spaziale di un progetto edilizio, come un sito, un edificio, un piano o uno spazio.</skos:definition>
        <skos:definition xml:lang="fr">Une subdivision spatiale d&apos;un projet de construction, telle qu&apos;un site, un bâtiment, un étage ou un espace.</skos:definition>
        <skos:prefLabel xml:lang="en">Building Zone</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Bygning Zone</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Bâtiment Zone</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Edificio Zone</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Gebäude Zone</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:extractionPrompt xml:lang="en">Any spatial decomposition of a building project, identified by name or id.</ont:extractionPrompt>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/bot#Zone"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#BuiltAsset -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#BuiltAsset">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A physical built asset such as a building, facility or piece of infrastructure, identified by name, title or id.</skos:definition>
        <skos:definition xml:lang="de">Eine physische bauliche Anlage wie ein Gebäude, eine Einrichtung oder Infrastruktur, angegeben durch Name, Titel oder ID.</skos:definition>
        <skos:definition xml:lang="da">Et fysisk bygget aktiv såsom en bygning, et anlæg eller infrastruktur, angivet ved navn, titel eller id.</skos:definition>
        <skos:definition xml:lang="fr">Un actif bâti physique tel qu&apos;un bâtiment, un équipement ou une infrastructure, identifié par son nom, son titre ou son identifiant.</skos:definition>
        <skos:definition xml:lang="it">Un bene edilizio fisico come un edificio, un impianto o un&apos;infrastruttura, identificato da nome, titolo o id.</skos:definition>
        <skos:prefLabel xml:lang="da">Built Asset</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Built Asset</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Built Asset</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Built Asset</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Built Asset</skos:prefLabel>
        <ont:extractionPrompt xml:lang="en">A built asset, identified by its title, name or id.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#CADFileContent -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#CADFileContent">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a computer-aided design (CAD) file, such as DWG or DXF.</skos:definition>
        <skos:prefLabel xml:lang="en">CAD File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#CertificationDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#CertificationDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#RegulatoryComplianceDocument"/>
        <skos:definition xml:lang="en">A certificate attesting compliance with a standard or requirement.</skos:definition>
        <skos:definition xml:lang="de">Eine Bescheinigung, die die Einhaltung einer Norm oder Anforderung bestätigt.</skos:definition>
        <skos:definition xml:lang="da">Et certifikat, der attesterer overholdelse af en standard eller et krav.</skos:definition>
        <skos:definition xml:lang="fr">Un certificat attestant la conformité à une norme ou à une exigence.</skos:definition>
        <skos:definition xml:lang="it">Un certificato che attesta la conformità a una norma o a un requisito.</skos:definition>
        <skos:prefLabel xml:lang="da">Certification Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Certification Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Certification Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Certification Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Certification Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ChangeOrderRFIDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ChangeOrderRFIDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <skos:definition xml:lang="en">A change order or request for information (RFI) issued during construction.</skos:definition>
        <skos:definition xml:lang="de">Ein Nachtrag oder eine Informationsanfrage (RFI), die während des Baus ausgestellt wird.</skos:definition>
        <skos:definition xml:lang="da">En ændringsordre eller anmodning om information (RFI) udstedt under byggeriet.</skos:definition>
        <skos:definition xml:lang="it">Un ordine di variazione o una richiesta di informazioni (RFI) emessa durante la costruzione.</skos:definition>
        <skos:definition xml:lang="fr">Un ordre de modification ou une demande d&apos;information (RFI) émis pendant la construction.</skos:definition>
        <skos:prefLabel xml:lang="da">Change Order &amp; RFI Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Change Order &amp; RFI Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Change Order &amp; RFI Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Change Order &amp; RFI Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Change Order &amp; RFI Document</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#City -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#City">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#Location"/>
        <skos:definition xml:lang="en">A city, town or municipality in which a project, asset or organization is located.</skos:definition>
        <skos:definition xml:lang="de">Eine Stadt oder Gemeinde, in der sich ein Projekt, eine Anlage oder eine Organisation befindet.</skos:definition>
        <skos:definition xml:lang="da">En by eller kommune, hvor et projekt, et aktiv eller en organisation er placeret.</skos:definition>
        <skos:definition xml:lang="it">Una città o un comune in cui si trova un progetto, un bene o un&apos;organizzazione.</skos:definition>
        <skos:definition xml:lang="fr">Une ville ou une municipalité où se situe un projet, un actif ou une organisation.</skos:definition>
        <skos:prefLabel xml:lang="da">By</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Città</skos:prefLabel>
        <skos:prefLabel xml:lang="en">City</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Stadt</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Ville</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Column -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Column">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <skos:definition xml:lang="en">A vertical structural element that carries loads down to the foundation.</skos:definition>
        <skos:definition xml:lang="de">Ein vertikales Tragelement, das Lasten zur Gründung ableitet.</skos:definition>
        <skos:definition xml:lang="da">Et lodret bærende element, der fører laster ned til fundamentet.</skos:definition>
        <skos:definition xml:lang="it">Un elemento strutturale verticale che trasferisce i carichi alle fondazioni.</skos:definition>
        <skos:definition xml:lang="fr">Un élément structurel vertical qui transmet les charges aux fondations.</skos:definition>
        <skos:prefLabel xml:lang="da">Column</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Column</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Column</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Column</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Column</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/beo#Column"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ComplianceReport -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ComplianceReport">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#RegulatoryComplianceDocument"/>
        <skos:definition xml:lang="en">A report demonstrating compliance with regulations or requirements.</skos:definition>
        <skos:definition xml:lang="de">Ein Bericht, der die Einhaltung von Vorschriften oder Anforderungen nachweist.</skos:definition>
        <skos:definition xml:lang="da">En rapport, der dokumenterer overholdelse af regler eller krav.</skos:definition>
        <skos:definition xml:lang="fr">Un rapport démontrant la conformité aux réglementations ou aux exigences.</skos:definition>
        <skos:definition xml:lang="it">Una relazione che dimostra la conformità a regolamenti o requisiti.</skos:definition>
        <skos:prefLabel xml:lang="da">Compliance Report</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Compliance Report</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Compliance Report</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Compliance Report</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Compliance Report</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ConstructionContract -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ConstructionContract">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:broader rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <skos:definition xml:lang="en">A contract governing the execution of construction works.</skos:definition>
        <skos:definition xml:lang="de">Ein Vertrag, der die Ausführung von Bauarbeiten regelt.</skos:definition>
        <skos:definition xml:lang="da">En kontrakt, der regulerer udførelsen af byggearbejder.</skos:definition>
        <skos:definition xml:lang="fr">Un contrat régissant l&apos;exécution des travaux de construction.</skos:definition>
        <skos:definition xml:lang="it">Un contratto che disciplina l&apos;esecuzione dei lavori di costruzione.</skos:definition>
        <skos:prefLabel xml:lang="en">Construction Contract</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Construction Contrat</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Construction Contratto</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Construction Kontrakt</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Construction Vertrag</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ConstructionProcessDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ConstructionProcessDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:definition xml:lang="it">Documenti utilizzati per pianificare, monitorare e controllare le attività di costruzione e la sicurezza.</skos:definition>
        <skos:definition xml:lang="en">Documents used to plan, monitor, and control construction activities and safety.</skos:definition>
        <skos:definition xml:lang="fr">Documents utilisés pour planifier, suivre et contrôler les activités de construction et la sécurité.</skos:definition>
        <skos:definition xml:lang="de">Dokumente zur Planung, Überwachung und Steuerung von Bauaktivitäten und Sicherheit.</skos:definition>
        <skos:definition xml:lang="da">Dokumenter, der bruges til at planlægge, overvåge og styre byggeaktiviteter og sikkerhed.</skos:definition>
        <skos:prefLabel xml:lang="da">Construction Process &amp; Management Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Construction Process &amp; Management Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Construction Process &amp; Management Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Construction Process &amp; Management Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Construction Process &amp; Management Document</skos:prefLabel>
        <ont:classificationPrompt xml:lang="en">Documents used to plan, monitor, and control construction activities and safety, such as project schedules, change orders, requests for information (RFIs), QA/QC reports, progress reports, and safety records.</ont:classificationPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#Contract -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#Contract">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A formal agreement between parties, identified by id, name or title.</skos:definition>
        <skos:definition xml:lang="de">Eine förmliche Vereinbarung zwischen Parteien, angegeben durch ID, Name oder Titel.</skos:definition>
        <skos:definition xml:lang="da">En formel aftale mellem parter, angivet ved id, navn eller titel.</skos:definition>
        <skos:definition xml:lang="fr">Un accord formel entre des parties, identifié par un identifiant, un nom ou un titre.</skos:definition>
        <skos:definition xml:lang="it">Un accordo formale tra parti, identificato da id, nome o titolo.</skos:definition>
        <skos:prefLabel xml:lang="en">Contract</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Contrat</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Contratto</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Kontrakt</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vertrag</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <ont:extractionPrompt xml:lang="en">The contract, identified by any means (id, name, title etc). If not explicitly mentioned, a descriptive term/title *must* be used instead.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ContractCondition -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ContractCondition">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A condition that must be met as part of a contractual obligation.</skos:definition>
        <skos:definition xml:lang="de">Eine Bedingung, die im Rahmen einer vertraglichen Verpflichtung erfüllt werden muss.</skos:definition>
        <skos:definition xml:lang="da">En betingelse, der skal opfyldes som led i en kontraktlig forpligtelse.</skos:definition>
        <skos:definition xml:lang="it">Una condizione che deve essere soddisfatta nell&apos;ambito di un obbligo contrattuale.</skos:definition>
        <skos:definition xml:lang="fr">Une condition qui doit être satisfaite dans le cadre d&apos;une obligation contractuelle.</skos:definition>
        <skos:prefLabel xml:lang="en">Contract Condition</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Contrat Condition</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Contratto Condizione</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Kontrakt Betingelse</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vertrag Bedingung</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <ont:extractionPrompt xml:lang="en">A certain condition that must be met, as part of a &apos;ContractObligation&apos;.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ContractObligation -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ContractObligation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">An obligation that a party must fulfil under a contract.</skos:definition>
        <skos:definition xml:lang="de">Eine Verpflichtung, die eine Partei im Rahmen eines Vertrags erfüllen muss.</skos:definition>
        <skos:definition xml:lang="da">En forpligtelse, som en part skal opfylde i henhold til en kontrakt.</skos:definition>
        <skos:definition xml:lang="it">Un obbligo che una parte deve adempiere ai sensi di un contratto.</skos:definition>
        <skos:definition xml:lang="fr">Une obligation qu&apos;une partie doit remplir au titre d&apos;un contrat.</skos:definition>
        <skos:prefLabel xml:lang="en">Contract Obligation</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Contrat Obligation</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Contratto Obligation</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Kontrakt Obligation</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vertrag Obligation</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <ont:extractionPrompt xml:lang="en">A certain obligation that must be undertaken in the context of the &apos;Contract&apos;.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ContractRole -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ContractRole">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <skos:definition xml:lang="en">A role undertaken by a party (organization or person) within a specific contract.</skos:definition>
        <skos:definition xml:lang="de">Eine Rolle, die von einer Partei (Organisation oder Person) im Rahmen eines bestimmten Vertrags übernommen wird.</skos:definition>
        <skos:definition xml:lang="da">En rolle, der varetages af en part (organisation eller person) inden for en bestemt kontrakt.</skos:definition>
        <skos:definition xml:lang="it">Un ruolo svolto da una parte (organizzazione o persona) nell&apos;ambito di un contratto specifico.</skos:definition>
        <skos:definition xml:lang="fr">Un rôle assumé par une partie (organisation ou personne) dans le cadre d&apos;un contrat spécifique.</skos:definition>
        <skos:prefLabel xml:lang="en">Contract Role</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Contrat Role</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Contratto Role</skos:prefLabel>
        <skos:prefLabel xml:lang="da">Kontrakt Role</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Vertrag Role</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <ont:extractionPrompt xml:lang="en">A certain role undertaken by a specific party (&apos;Organization&apos; or &apos;Person&apos;) in the context of a specific &apos;Contract&apos;.</ont:extractionPrompt>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ContractualDocument -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ContractualDocument">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <skos:definition xml:lang="it">Accordi, contratti e atti legali che stabiliscono obblighi, diritti e responsabilità.</skos:definition>
        <skos:definition xml:lang="fr">Accords, contrats et documents juridiques qui établissent des obligations, des droits et des responsabilités.</skos:definition>
        <skos:definition xml:lang="da">Aftaler, kontrakter og juridiske dokumenter, der fastlægger forpligtelser, rettigheder og ansvar.</skos:definition>
        <skos:definition xml:lang="en">Agreements, contracts, and legal filings that establish obligations, rights, and responsibilities.</skos:definition>
        <skos:definition xml:lang="de">Vereinbarungen, Verträge und rechtliche Unterlagen, die Pflichten, Rechte und Verantwortlichkeiten festlegen.</skos:definition>
        <skos:prefLabel xml:lang="da">Contractual &amp; Legal Document</skos:prefLabel>
        <skos:prefLabel xml:lang="de">Contractual &amp; Legal Document</skos:prefLabel>
        <skos:prefLabel xml:lang="en">Contractual &amp; Legal Document</skos:prefLabel>
        <skos:prefLabel xml:lang="fr">Contractual &amp; Legal Document</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Contractual &amp; Legal Document</skos:prefLabel>
        <ont:classificationPrompt xml:lang="en">Documents that establish obligations, rights, and responsibilities, such as purchase agreements, lease agreements, construction contracts, insurance documents, and bonds.</ont:classificationPrompt>
    </owl:NamedIndividual>
    


