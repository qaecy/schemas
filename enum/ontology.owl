        <skos:prefLabel xml:lang="fr">Roof</skos:prefLabel>
        <skos:prefLabel xml:lang="it">Roof</skos:prefLabel>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <ont:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/beo#Roof"/>
        <ont:relatedFormalClass rdf:resource="https://w3id.org/rec#Roof"/>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#SVGPathGeometry -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#SVGPathGeometry">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
