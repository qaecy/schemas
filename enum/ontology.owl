        <rdf:type rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <skos:definition xml:lang="en">Content of a multimedia file combining audio, video or interactive media.</skos:definition>
        <skos:prefLabel xml:lang="en">Multimedia File Content</skos:prefLabel>
    </owl:NamedIndividual>
    


    <!-- https://dev.qaecy.com/enum#ObjectId -->


    <owl:NamedIndividual rdf:about="https://dev.qaecy.com/enum#ObjectId">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdf:type rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
