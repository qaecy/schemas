     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated"/>
    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used"/>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith"/>
    


    <!-- https://dev.qaecy.com/logs#consumed -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/logs#consumed">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:comment xml:lang="en">Sub-processes or external processes consumed by this process.</rdfs:comment>
        <rdfs:label xml:lang="en">consumed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/logs#executedBy -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/logs#executedBy">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Service"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:label xml:lang="en">executed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/logs#hasService -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/logs#hasService">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <owl:inverseOf rdf:resource="https://dev.qaecy.com/logs#executedBy"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/logs#Service"/>
        <rdfs:comment xml:lang="en">The service that executed this process.</rdfs:comment>
        <rdfs:label xml:lang="en">has service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/logs#hasSource -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/logs#hasSource">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#used"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:comment xml:lang="en">Source file location used by this process.</rdfs:comment>
        <rdfs:label xml:lang="en">has source</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/logs#hasTarget -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/logs#hasTarget">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generated"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:comment xml:lang="en">Target file location generated by this process.</rdfs:comment>
        <rdfs:label xml:lang="en">has target</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#endedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#endedAtTime"/>
    


    <!-- http://www.w3.org/ns/prov#startedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#startedAtTime"/>
    


    <!-- https://dev.qaecy.com/logs#duration -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#duration">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Human-readable duration string (e.g., &apos;17.1 s&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">duration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#embeddingsDimensions -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#embeddingsDimensions">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#EmbeddingRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Dimensionality of the embedding vectors produced.</rdfs:comment>
        <rdfs:label xml:lang="en">embeddings dimensions</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#embeddingsSize -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#embeddingsSize">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#EmbeddingRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of inputs (e.g. text chunks) sent in the embedding request.</rdfs:comment>
        <rdfs:label xml:lang="en">embeddings size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#embeddingsTokenizer -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#embeddingsTokenizer">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#EmbeddingRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name or identifier of the tokenizer used for the embedding request.</rdfs:comment>
        <rdfs:label xml:lang="en">embeddings tokenizer</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#embeddingsUnits -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#embeddingsUnits">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#EmbeddingRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Total number of tokens processed by the embedding model.</rdfs:comment>
        <rdfs:label xml:lang="en">embeddings units</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#endTime -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#endTime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#endedAtTime"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp when the process ended.</rdfs:comment>
        <rdfs:label xml:lang="en">end time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#llmThinking -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#llmThinking">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#LLMRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether the process used thinking.</rdfs:comment>
        <rdfs:label xml:lang="en">llm used thinking</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#llmTokensIn -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#llmTokensIn">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#LLMRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Input tokens consumed by LLM request.</rdfs:comment>
        <rdfs:label xml:lang="en">llm tokens in</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#llmTokensOut -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#llmTokensOut">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#LLMRequest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Output tokens consumed by LLM request.</rdfs:comment>
        <rdfs:label xml:lang="en">llm tokens out</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#message -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#message">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A message such as an error or informational message.</rdfs:comment>
        <rdfs:label xml:lang="en">message</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionAvgConfidence -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionAvgConfidence">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Average confidence score across all resolutions in this phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution average confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionCategory -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionCategory">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Category of entity being resolved (e.g. person, organisation).</rdfs:comment>
        <rdfs:label xml:lang="en">resolution category</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionDurationMs -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionDurationMs">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Wall-clock duration of this resolution phase in milliseconds.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution duration ms</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionExistingCanonicalsCount -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionExistingCanonicalsCount">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of pre-existing canonical entities matched during this phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution existing canonicals count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionIteration -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionIteration">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Iteration index of this resolution phase within the overall resolution run.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution iteration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionMentionsIn -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionMentionsIn">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of mentions submitted for resolution in this phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution mentions in</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionMentionsResolved -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionMentionsResolved">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of mentions successfully resolved in this phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution mentions resolved</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionNewCanonicalsCreated -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionNewCanonicalsCreated">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">Number of new canonical entities created during this phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution new canonicals created</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#resolutionPhaseName -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#resolutionPhaseName">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#ResolutionPhase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Human-readable name identifying the resolution phase.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution phase name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#startTime -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#startTime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#startedAtTime"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Timestamp when the process started.</rdfs:comment>
        <rdfs:label xml:lang="en">start time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/logs#success -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/logs#success">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/logs#Process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Whether the process completed successfully.</rdfs:comment>
        <rdfs:label xml:lang="en">success</rdfs:label>
    </owl:DatatypeProperty>
    


