}, {
  "@id" : "https://dev.qaecy.com/ont#decidedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Who authored an identity decision — a person, an agent, or the resolver itself. Human and agent decisions are recorded so that they can be recognised, audited, and protected from being undone by automatic passes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "decided by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#derivedFrom",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between an inferred qcy:RelationMeta between two qcy:CanonicalEntity and each of the mention-level qcy:RelationMeta it was derived from. The canonical-level node states that the relationship holds and which qcy:RelationCategory it carries; the mention-level ones it points at hold the evidence — the qcy:description of what in a document established it, its confidence, and through their subject and object the document itself. Written by saturation, never asserted."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#RelationMeta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "derived from"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#RelationMeta"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#description",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityMention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Text situating a thing in the context it was found in, so that it can be interpreted without returning to the source. On a qcy:EntityMention or qcy:CanonicalEntity this is what distinguishes it from a similarly named one elsewhere - what contains it, which revision or party it belongs to, the role it plays. Written either by a Large Language model at extraction time, where it is kept under ~50 words, or by a processor summarising a source record, where it may be considerably longer. Consumers that feed it to a model should expect the latter and truncate."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "description"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
