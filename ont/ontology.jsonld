    "@language" : "da",
    "@value" : "Relation der angiver slut-, ophørs- eller udløbsdatoen for en entitet."
  }, {
    "@language" : "fr",
    "@value" : "Relation qui indique la date de fin, de résiliation ou d'expiration d'une entité."
  }, {
    "@language" : "it",
    "@value" : "Relazione che indica la data di fine, cessazione o scadenza di un'entità."
  }, {
    "@value" : "Relationship that specifies the end, termination, or expiration date of an entity."
  } ],
