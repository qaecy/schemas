  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between a qcy:RelationMeta node and the subject entity of the qualified relationship."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
