}, {
  "@id" : "https://dev.qaecy.com/ont#enrichmentAttemptCount",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The number of times enrichment has been attempted for this canonical entity. Used to limit retry attempts for enrichment processes (e.g., geocoding addresses). After a maximum number of attempts, the entity is no longer considered for enrichment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "enrichment attempt count"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#explicit",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A boolean property specifying that something is explicit. It is specifically used to indicate that a qcy:CanonicalEntity has been confirmed by an authorized project practitioner or other specialist."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "explicit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#boolean"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#expressedBy",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation der udtrykker en egenskab eller kvalitet ved en entitet (fx at en tegning udtrykkes ved sin målestok, orientering osv.)."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau qui exprime une caractéristique ou une qualité d'une entité (par ex. un dessin est exprimé par son échelle, son orientation, etc.)."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello che esprime una caratteristica o qualità di un'entità (ad esempio un disegno è espresso dalla sua scala, orientamento, ecc.)."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung, die eine Eigenschaft oder Qualität einer Entität ausdrückt (z. B. wird eine Zeichnung durch Maßstab, Ausrichtung usw. ausgedrückt)."
  }, {
    "@value" : "Top level relationship that expresses a characteristic or quality of an entity (eg. a drawing is expressed by its scale, orientation etc.)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "ausgedrückt durch"
  }, {
    "@language" : "it",
    "@value" : "espresso da"
  }, {
    "@language" : "en",
    "@value" : "expressed by"
  }, {
    "@language" : "fr",
    "@value" : "exprimé par"
  }, {
    "@language" : "da",
    "@value" : "udtrykt ved"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#relatedEntity"
  } ],
  "https://dev.qaecy.com/template#extractionPrompt" : [ {
    "@value" : "B is something about A - a quality, a quantity, a time, a material, a shape, a file."
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#extractedWithSchemaRevision",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "https://dev.qaecy.com/ont#InformationObject"
  } ],
