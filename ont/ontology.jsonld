  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#filePath",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The file path property specifies the location of a file within its qcy:FileProvider. For a local device it is the absolute path on that machine, normalised to forward slashes (e.g. \"/Users/anna/Projects/Nest/A-101.pdf\" or \"C:/Projects/Nest/A-101.pdf\"). For other providers it is the path as the provider presents it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#FileLocation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "file path"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#follows",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation der angiver, at en entitet kommer efter eller følger af en anden entitet. Den senere entitet er subjektet."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau indiquant qu'une entité vient après une autre entité, ou en résulte. L'entité la plus tardive est le sujet."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello che indica che un'entità viene dopo un'altra entità, o ne deriva. L'entità successiva è il soggetto."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung, die angibt, dass eine Entität auf eine andere folgt oder aus ihr hervorgeht. Die spätere Entität ist das Subjekt."
  }, {
    "@value" : "Top level relationship that indicates that an entity comes after, or results from, another entity. Written with the later entity as the subject, because at the time a thing is recorded what it followed is known and what will follow it is not."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "folgt"
  }, {
    "@language" : "en",
    "@value" : "follows"
  }, {
    "@language" : "da",
    "@value" : "følger"
  }, {
    "@language" : "it",
    "@value" : "segue"
  }, {
    "@language" : "fr",
    "@value" : "suit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#relatedEntity"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#leadsTo"
  } ],
  "https://dev.qaecy.com/template#extractionPrompt" : [ {
    "@value" : "A comes after B, or results from it."
  } ]
