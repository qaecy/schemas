  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#selectorObject",
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  }, {
    "@id" : "https://dev.qaecy.com/ont#EntityMention"
  }, {
    "@id" : "https://dev.qaecy.com/ont#InformationObject"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between a qcy:Selector and the thing it specifies. This is typically a qcy:EntityMention (eg this part of the text mentions the entity), a qcy:InformationObject (eg this picture is placed here on the page) or a qcy:CanonicalEntity (eg this part of the file path names this entity)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#Selector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "selector object"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#selectorSubject",
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "https://dev.qaecy.com/ont#FileLocation"
  }, {
    "@id" : "https://dev.qaecy.com/ont#InformationObject"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between a qcy:Selector and the thing it specifies a location within. This is typically a qcy:InformationObject, but it can also be a qcy:FileLocation - a qcy:FilePathSelector points at a range of that location's qcy:filePath, and a qcy:RecordFieldSelector at the field of a register that described it. Stated with schema:rangeIncludes rather than rdfs:range because qcy:FileLocation and qcy:InformationObject are disjoint, so a single rdfs:range would make every file-location selector an inconsistency."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#Selector"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "selector subject"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#sheetContainsDrawing",
