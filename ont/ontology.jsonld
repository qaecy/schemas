  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Beziehung, die das Startdatum einer Entität in einem Prozesskontext angibt."
  }, {
    "@language" : "da",
    "@value" : "Relation der angiver startdatoen for en entitet i en proceskontekst."
