}, {
  "@id" : "https://dev.qaecy.com/ont#signedOn",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Beziehung, die das Unterzeichnungsdatum einer Entität angibt, z. B. eines Vertrags."
  }, {
    "@language" : "da",
    "@value" : "Relation der angiver underskriftsdatoen for en entitet, f.eks. en kontrakt."
  }, {
    "@language" : "fr",
    "@value" : "Relation qui indique la date de signature d'une entité, par exemple un contrat."
  }, {
    "@language" : "it",
    "@value" : "Relazione che indica la data di firma di un'entità, ad esempio un contratto."
  }, {
    "@value" : "Relationship that specifies the signature date of an entity such as a contract."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "it",
    "@value" : "firmato il"
  }, {
    "@language" : "en",
    "@value" : "signed on"
  }, {
    "@language" : "fr",
    "@value" : "signé le"
  }, {
    "@language" : "da",
    "@value" : "underskrevet den"
  }, {
    "@language" : "de",
    "@value" : "unterzeichnet am"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
