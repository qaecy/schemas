}, {
  "@id" : "https://dev.qaecy.com/ont#hasProperty",
  "http://schema.org/domainIncludes" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  }, {
    "@id" : "https://dev.qaecy.com/ont#FileLocation"
  }, {
    "@id" : "https://dev.qaecy.com/ont#InformationObject"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between something and one of its qcy:Properties. Typically a qcy:EntityMention or a qcy:CanonicalEntity, but also a qcy:FileLocation or a qcy:InformationObject: a DMS register records things about a file - its document type, its status, the department that filed it - that are neither entities to resolve nor facts about a file's content, and a qcy:Property holding a label and a value is what those become. Stated with schema:domainIncludes rather than rdfs:domain because qcy:FileLocation, qcy:InformationObject and qcy:EntityReference are pairwise disjoint, so a single rdfs:domain would make every register property an inconsistency - the same reason qcy:mentions, qcy:about and qcy:selectorSubject are stated that way."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#Property"
  } ]
}, {
