  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between a qcy:RelationMeta node and the group of qcy:relatedEntity that it qualifies (e.g. qcy:involves, qcy:contains, qcy:follows). DECIDED: nothing emits this. The edge between the subject and the object already names the group, and no consumer reads this property, so writing it would be a second copy of a fact that can go stale. It stays declared because old data may carry it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#RelationMeta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has relation meta property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ]
}, {
