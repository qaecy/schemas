  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "de",
    "@value" : "beginnt am"
  }, {
    "@language" : "fr",
    "@value" : "commence le"
  }, {
    "@language" : "it",
    "@value" : "inizia il"
  }, {
    "@language" : "da",
    "@value" : "starter den"
  }, {
    "@language" : "en",
