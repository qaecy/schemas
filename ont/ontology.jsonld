}, {
  "@id" : "https://dev.qaecy.com/ont#leadsTo",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation der angiver, at en entitet fører til en anden entitet. Den udtrykker en sekventiel eller kausal afhængighed mellem to entiteter."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau indiquant qu'une entité mène à une autre entité. Elle exprime une dépendance séquentielle ou causale entre deux entités."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello che indica che un'entità porta a un'altra entità. Esprime una dipendenza sequenziale o causale tra due entità."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung, die angibt, dass eine Entität zu einer anderen Entität führt. Sie drückt eine sequenzielle oder kausale Abhängigkeit zwischen zwei Entitäten aus."
  }, {
    "@value" : "DEPRECATED: This property is outdated. Please use qcy:follows instead, which states the same ordering with the later entity as the subject."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "da",
    "@value" : "fører til"
  }, {
    "@language" : "de",
    "@value" : "führt zu"
  }, {
    "@language" : "en",
    "@value" : "leads to"
  }, {
    "@language" : "fr",
    "@value" : "mène à"
  }, {
    "@language" : "it",
    "@value" : "porta a"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#relatedEntity"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#md5Hash",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The 32 character MD5 hash in lower case hexadecimals (empty string = d41d8cd98f00b204e9800998ecf8427e)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#FileContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MD5 hash"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "https://dev.qaecy.com/template#regex" : [ {
    "@value" : "^[a-f0-9]{32}$"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#md5HashBase64",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The 24 character MD5 hash in Base64 encoding (empty string = 1B2M2Y8AsgTpgAmY7PhCfg==)"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#FileContent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "MD5 hash Base 64"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ],
  "https://dev.qaecy.com/template#regex" : [ {
    "@value" : "^[a-zA-Z0-9+/=]{24}$"
  } ]
