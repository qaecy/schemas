  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#inheritsFrom",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between an occurrence and the qcy:EntityPrototype it takes its shared properties from - a door instance and its IFC type. Deliberately NOT a qcy:relatedEntity: it says \"is the same kind of thing as\", not \"is related to\", and a BIM model carries one per element, so lifting it into the groups would bury every real relation under prototype links."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityMention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "inherits from"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityPrototype"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#interfaceOf",
