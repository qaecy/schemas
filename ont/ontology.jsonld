}, {
  "@id" : "https://dev.qaecy.com/ont#hasTemporalMarker",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation for tidslig kvalificering af en entitet på tværs af livscyklus-, juridiske- og proceskontekster."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau pour la qualification temporelle d'une entité dans des contextes de cycle de vie, juridiques et de processus."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello per la qualificazione temporale di un'entità nei contesti di ciclo di vita, legali e di processo."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung zur zeitlichen Qualifizierung einer Entität über Lebenszyklus-, rechtliche und Prozesskontexte hinweg."
  }, {
    "@value" : "Top level relationship for temporal qualification of an entity across lifecycle, legal, and process contexts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a un marqueur temporel"
  }, {
    "@language" : "it",
    "@value" : "ha un marcatore temporale"
  }, {
    "@language" : "da",
    "@value" : "har tidsmarkør"
  }, {
    "@language" : "en",
    "@value" : "has temporal marker"
  }, {
    "@language" : "de",
    "@value" : "hat zeitliche Markierung"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#expressedBy"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
