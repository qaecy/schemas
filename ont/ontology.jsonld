    "@value" : "resolution attempt count"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#resolutionScopeKey",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The resolved scope a qcy:CanonicalEntity was minted under - the identifiers of its scoping parents, as used in its deterministic identifier. Storey \"1\" of one building and storey \"1\" of another are distinct entities carrying the same value, and this is what separates them once they are read back out of the graph: without it a candidate retrieved by similarity carries no scope, and a scope conflict cannot be detected. Empty for categories whose identity does not depend on a containing entity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "resolution scope key"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#resolutionStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A terminal, non-resolving outcome for a qcy:EntityMention. \"noise\" means the value failed its category's validation and is not a usable entity reference; \"ambiguous\" means resolution declined to choose among candidates and the mention awaits human review. A mention with this property is not reconsidered by routine resolution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityMention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "resolution status"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#resolvedForm",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A surface form that was judged to denote this qcy:CanonicalEntity but does not normalize to its value - an alias, a translation, an abbreviation. The identifier of a canonical entity is derived from its own normalized value, so a form that merges into it leaves no trace under its own identifier and the cheap identity probe cannot find it again: every later occurrence of that form would be re-adjudicated from scratch, at the same cost, forever. Recording the form here makes the second occurrence free. Values are the same deterministic form identifier the probe computes."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "resolved form"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#resolvesTo",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship between a qcy:EntityMention and a qcy:CanonicalEntity. This property indicates that a named entity occurrence resolves to a canonical entity, meaning that the named entity is recognized as an instance of the canonical entity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityMention"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "resolves to"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#CanonicalEntity"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#reviewer",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Relationship that specifies that a person or organization is a reviewer of the entity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
