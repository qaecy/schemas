  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#interfaces",
  "@type" : [ "http://www.w3.org/2002/07/owl#SymmetricProperty" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation der angiver, at to entiteter mødes - de berører hinanden, overlapper, kommunikerer eller arbejder sammen."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau indiquant que deux entités se rencontrent - elles se touchent, se chevauchent, communiquent ou travaillent ensemble."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello che indica che due entità si incontrano - si toccano, si sovrappongono, comunicano o lavorano insieme."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung, die angibt, dass zwei Entitäten aufeinandertreffen - sie berühren sich, überlappen, kommunizieren oder arbeiten zusammen."
  }, {
    "@value" : "Top level relationship that indicates that two entities meet. Covers physical contact and overlap as well as the looser sense of two things that communicate or work together, so the space in which they are close is named by the relation category rather than by the predicate."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "est en interface avec"
  }, {
    "@language" : "de",
    "@value" : "grenzt an"
  }, {
    "@language" : "da",
    "@value" : "grænser op til"
  }, {
    "@language" : "en",
    "@value" : "interfaces"
  }, {
    "@language" : "it",
    "@value" : "si interfaccia con"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#relatedEntity"
  } ],
  "https://dev.qaecy.com/template#extractionPrompt" : [ {
    "@value" : "A and B meet - they touch, overlap, communicate, or work together."
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#intersectsWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#SymmetricProperty" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "DEPRECATED: This property is outdated. Please use qcy:interfaces with the Intersects relation category instead."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "intersects with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#interfaces"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#invalidatedOn",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "de",
    "@value" : "Beziehung, die angibt, wann eine Entität ungültig wurde."
  }, {
    "@language" : "da",
    "@value" : "Relation der angiver, hvornår en entitet blev ugyldig."
  }, {
    "@language" : "fr",
    "@value" : "Relation qui indique quand une entité est devenue invalide."
  }, {
    "@language" : "it",
    "@value" : "Relazione che indica quando un'entità è diventata non valida."
  }, {
    "@value" : "Relationship that specifies when an entity became invalid."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "invalidated on"
  }, {
    "@language" : "it",
    "@value" : "invalidato il"
  }, {
    "@language" : "fr",
    "@value" : "invalidé le"
  }, {
    "@language" : "da",
    "@value" : "ugyldiggjort den"
  }, {
    "@language" : "de",
    "@value" : "ungültig ab"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://dev.qaecy.com/ont#EntityReference"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://dev.qaecy.com/ont#hasTemporalMarker"
  } ],
  "http://www.w3.org/2002/07/owl#deprecated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#boolean",
    "@value" : "true"
  } ]
}, {
  "@id" : "https://dev.qaecy.com/ont#involves",
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#ObjectProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "da",
    "@value" : "Overordnet relation der angiver, at en entitet involverer en anden entitet. Den udtrykker deltagelse eller involvering i en aktivitet eller proces."
  }, {
    "@language" : "fr",
    "@value" : "Relation de haut niveau indiquant qu'une entité en implique une autre. Elle exprime la participation ou l'engagement dans une activité ou un processus."
  }, {
    "@language" : "it",
    "@value" : "Relazione di alto livello che indica che un'entità coinvolge un'altra entità. Esprime partecipazione o coinvolgimento in un'attività o processo."
  }, {
    "@language" : "de",
    "@value" : "Übergeordnete Beziehung, die angibt, dass eine Entität eine andere Entität einbezieht. Sie drückt Teilnahme oder Beteiligung an einer Aktivität oder einem Prozess aus."
  }, {
    "@value" : "Top level relationship that indicates that an entity involves another entity. It expresses a participation or engagement in some activity or process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
