        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <rdfs:comment>Relationship between a qcy:InformationObject (typically a whole document or a page in a document) and its qcy:ContentCategory derived from its content.</rdfs:comment>
        <rdfs:label xml:lang="en">has content category</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </owl:ObjectProperty>
    


