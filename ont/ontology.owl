    <!-- https://dev.qaecy.com/ont#about -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#about">
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between a qcy:InformationObject/qcy:FileLocation and a qcy:CanonicalEntity. This property indicates that a file content, fragment or file location is about a specific canonical entity. It can be implicitly derived that if a file content, fragment or file location mentions the occurrence of a named entity, and that named entity resolves to a canonical entity, then it is about the canonical entity.</rdfs:comment>
        <rdfs:label xml:lang="en">about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#absorbed -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#absorbed">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:comment xml:lang="en">Inverse of qcy:mergedInto: the surviving qcy:CanonicalEntity records which entities it absorbed, so a merge can be audited and undone.</rdfs:comment>
        <rdfs:label xml:lang="en">absorbed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#activityHasEndDate -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#activityHasEndDate">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#endsOn"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:endsOn instead. Relationship that specifies the date that an activity ends.</rdfs:comment>
        <rdfs:label xml:lang="en">activity has end date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Date"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Activity"/>
        <template:extractionPrompt>An &apos;Activity&apos; has an end &apos;Date&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#activityHasStartDate -->


