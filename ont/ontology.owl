        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship that specifies the duration of an activity.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Duration"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Activity"/>
        <template:extractionPrompt>An &apos;Activity&apos; has a certain &apos;Duration&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasEmailAddress -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasEmailAddress">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#expressedBy"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that states that an email address belongs to a person or an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">has email address</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#EmailAddress"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Organization"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Person"/>
        <template:extractionPrompt>A &apos;Person&apos; or an &apos;Organization&apos; has an &apos;EmailAddress&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasEmailReceiver -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasEmailReceiver">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#involves"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that specifies the receiving email address of an email file.</rdfs:comment>
        <rdfs:label xml:lang="en">has email receiver</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#EmailAddress"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#EmailFileContent"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasEmailSender -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasEmailSender">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#involves"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that specifies the sending email address of an email file.</rdfs:comment>
        <rdfs:label xml:lang="en">has email sender</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#EmailAddress"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#EmailFileContent"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasEntityCategory -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasEntityCategory">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasCategory"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <rdfs:comment>Relationship between a qcy:EntityReference and one or more qcy:EntityCategory.</rdfs:comment>
        <rdfs:label xml:lang="en">has entity category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasFileLocation -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasFileLocation">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:comment>Relationship between a qcy:InformationObject and one of its qcy:FileLocation(s). All qcy:FileContent instances have at least one location and other information objects such as a qcy:ImageFragment also have a file location</rdfs:comment>
        <rdfs:label xml:lang="en">has file location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasFoundingMention -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasFoundingMention">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:comment xml:lang="en">Relationship indicating that a Canonical Entity was originally established or founded based on this specific Entity Mention. This property highlights the mentions that were primary and instrumental in the initial creation or identification of the canonical entity&apos;s concept.</rdfs:comment>
        <rdfs:label xml:lang="en">has founding mention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasGeometry -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasGeometry">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#expressedBy"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Relationship between a qcy:CanonicalEntity and its geometric representation (for example the SVG polygon org glTF of a BIM object).</rdfs:comment>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasLocation -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasLocation">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#expressedBy"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that states that an entity has a physical location.</rdfs:comment>
        <rdfs:label xml:lang="en">has location</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Location"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#BuiltAsset"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Organization"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Person"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#ProjectId"/>
        <template:extractionPrompt>A &apos;Person&apos;, &apos;Organization&apos;, &apos;BuiltAsset&apos; or &apos;ProjectId&apos; has a certain &apos;Location&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasMimeCategory -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasMimeCategory">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasCategory"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#MimeCategory"/>
        <rdfs:comment>Relationship between a qcy:FileContent object and its qcy:MimeCategory derived from its mimetype.</rdfs:comment>
        <rdfs:label xml:lang="en">has mime category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasProperty -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasProperty">
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between something and one of its qcy:Properties. Typically a qcy:EntityMention or a qcy:CanonicalEntity, but also a qcy:FileLocation or a qcy:InformationObject: a DMS register records things about a file - its document type, its status, the department that filed it - that are neither entities to resolve nor facts about a file&apos;s content, and a qcy:Property holding a label and a value is what those become. Stated with schema:domainIncludes rather than rdfs:domain because qcy:FileLocation, qcy:InformationObject and qcy:EntityReference are pairwise disjoint, so a single rdfs:domain would make every register property an inconsistency - the same reason qcy:mentions, qcy:about and qcy:selectorSubject are stated that way.</rdfs:comment>
        <rdfs:label xml:lang="en">has property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasRelationCategory -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasRelationCategory">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasCategory"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#RelationCategory"/>
        <rdfs:comment>Relationship between a qcy:RelationMeta node and its qcy:RelationCategory, specifying the role or type of the qualified relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">has relation category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasRelationMetaObject -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasRelationMetaObject">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>Relationship between a qcy:RelationMeta node and the object entity of the qualified relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">has relation meta object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasRelationMetaProperty -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasRelationMetaProperty">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
        <rdfs:comment>Relationship between a qcy:RelationMeta node and the group of qcy:relatedEntity that it qualifies (e.g. qcy:involves, qcy:contains, qcy:follows). DECIDED: nothing emits this. The edge between the subject and the object already names the group, and no consumer reads this property, so writing it would be a second copy of a fact that can go stale. It stays declared because old data may carry it.</rdfs:comment>
        <rdfs:label xml:lang="en">has relation meta property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasRelationMetaSubject -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasRelationMetaSubject">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>Relationship between a qcy:RelationMeta node and the subject entity of the qualified relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">has relation meta subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasSubElement -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasSubElement">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasTemporalMarker -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasTemporalMarker">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#expressedBy"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="da">Overordnet relation for tidslig kvalificering af en entitet på tværs af livscyklus-, juridiske- og proceskontekster.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau pour la qualification temporelle d&apos;une entité dans des contextes de cycle de vie, juridiques et de processus.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello per la qualificazione temporale di un&apos;entità nei contesti di ciclo di vita, legali e di processo.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung zur zeitlichen Qualifizierung einer Entität über Lebenszyklus-, rechtliche und Prozesskontexte hinweg.</rdfs:comment>
        <rdfs:comment>Top level relationship for temporal qualification of an entity across lifecycle, legal, and process contexts.</rdfs:comment>
        <rdfs:label xml:lang="fr">a un marqueur temporel</rdfs:label>
        <rdfs:label xml:lang="it">ha un marcatore temporale</rdfs:label>
        <rdfs:label xml:lang="da">har tidsmarkør</rdfs:label>
        <rdfs:label xml:lang="en">has temporal marker</rdfs:label>
        <rdfs:label xml:lang="de">hat zeitliche Markierung</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#implicitlyContainsFragment -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#implicitlyContainsFragment">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment>Relationship between a qcy:InformationObject and a qcy:Fragment it contains at any depth: one of its own qcy:Fragments, or a qcy:Fragment of one of those. qcy:containsFragment states the direct containment</rdfs:comment>
        <rdfs:label xml:lang="en">implicitly contains fragment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#includesActivity -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#includesActivity">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that specifies that an activity is part of a schedule / project-plan.</rdfs:comment>
        <rdfs:label xml:lang="en">includes activity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Activity"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Schedule"/>
        <template:extractionPrompt>A &apos;Schedule&apos; includes an &apos;Activity&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#includesBuildingEntity -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#includesBuildingEntity">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that states that the drawing entity includes a building zone or a building element.</rdfs:comment>
        <rdfs:label xml:lang="en">includes building entity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingZone"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#DrawingEntity"/>
        <template:extractionPrompt>The &apos;DrawingEntity&apos; includes a &apos;BuildingZone&apos; or &apos;BuildingElement&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#inheritsFrom -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#inheritsFrom">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityPrototype"/>
        <rdfs:comment>Relationship between an occurrence and the qcy:EntityPrototype it takes its shared properties from - a door instance and its IFC type. Deliberately NOT a qcy:relatedEntity: it says &quot;is the same kind of thing as&quot;, not &quot;is related to&quot;, and a BIM model carries one per element, so lifting it into the groups would bury every real relation under prototype links.</rdfs:comment>
        <rdfs:label xml:lang="en">inherits from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#interfaceOf -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#interfaceOf">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#interfaces -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#interfaces">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="da">Overordnet relation der angiver, at to entiteter mødes - de berører hinanden, overlapper, kommunikerer eller arbejder sammen.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau indiquant que deux entités se rencontrent - elles se touchent, se chevauchent, communiquent ou travaillent ensemble.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello che indica che due entità si incontrano - si toccano, si sovrappongono, comunicano o lavorano insieme.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung, die angibt, dass zwei Entitäten aufeinandertreffen - sie berühren sich, überlappen, kommunizieren oder arbeiten zusammen.</rdfs:comment>
        <rdfs:comment>Top level relationship that indicates that two entities meet. Covers physical contact and overlap as well as the looser sense of two things that communicate or work together, so the space in which they are close is named by the relation category rather than by the predicate.</rdfs:comment>
        <rdfs:label xml:lang="fr">est en interface avec</rdfs:label>
        <rdfs:label xml:lang="de">grenzt an</rdfs:label>
        <rdfs:label xml:lang="da">grænser op til</rdfs:label>
        <rdfs:label xml:lang="en">interfaces</rdfs:label>
        <rdfs:label xml:lang="it">si interfaccia con</rdfs:label>
        <template:extractionPrompt>A and B meet - they touch, overlap, communicate, or work together.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#intersectsWith -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#intersectsWith">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#interfaces"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:interfaces with the Intersects relation category instead.</rdfs:comment>
        <rdfs:label xml:lang="en">intersects with</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#invalidatedOn -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#invalidatedOn">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasTemporalMarker"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="de">Beziehung, die angibt, wann eine Entität ungültig wurde.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver, hvornår en entitet blev ugyldig.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique quand une entité est devenue invalide.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica quando un&apos;entità è diventata non valida.</rdfs:comment>
        <rdfs:comment>Relationship that specifies when an entity became invalid.</rdfs:comment>
        <rdfs:label xml:lang="en">invalidated on</rdfs:label>
        <rdfs:label xml:lang="it">invalidato il</rdfs:label>
        <rdfs:label xml:lang="fr">invalidé le</rdfs:label>
        <rdfs:label xml:lang="da">ugyldiggjort den</rdfs:label>
