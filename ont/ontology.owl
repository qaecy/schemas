    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description rdf:about="https://dev.qaecy.com/ont#IFCExpressIDSelector">
        <rdfs:comment xml:lang="en">The value of an IFC Express ID Selector specifies the ExpressId of the object within the IFC document. Beware that this ID is only unique in context of that single serailization of the model and is likely to change in future versions of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">IFC Express ID Selector</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#IFCGlobalIDSelector">
        <rdfs:comment xml:lang="en">The value of an IFC Global ID Selector specifies the GlobalId of the object within the IFC document.</rdfs:comment>
        <rdfs:label xml:lang="en">IFC Global ID Selector</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#TextFragment">
        <rdfs:comment xml:lang="en">This special fragment constitutes a text extraction. It can be the full text of a page a paragraph, footer, header or the like. Except for the former case, it should specified with a selector (qcy:XYWHSelector) to describe it&apos;s location relative to its parent fragment. It should also specify a qcy:textRaw and optionally a qcy:textFormatted.</rdfs:comment>
        <rdfs:label xml:lang="en">Text Fragment</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#XYWHSelector">
        <terms:conformsTo rdf:resource="http://www.w3.org/TR/media-frags/"/>
        <rdfs:comment xml:lang="en">The value specifies the bounding box formatted as an xywh box (http://www.w3.org/TR/media-frags/) either in absolute pixels or relative to the information object. The XYWH Selector is used to identify the location of a qcy:EntityMention or qcy:InformationObject within a visual document.</rdfs:comment>
        <rdfs:label xml:lang="en">XYWH Selector</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#activityHasEndDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:endsOn instead. Relationship that specifies the date that an activity ends.</rdfs:comment>
        <rdfs:label xml:lang="en">activity has end date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#activityHasStartDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:startsOn instead. Relationship that specifies the date that an activity begins.</rdfs:comment>
        <rdfs:label xml:lang="en">activity has start date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#adjacentTo">
        <rdfs:comment>Relationship that specifies that two things are adjacent to each other.</rdfs:comment>
        <rdfs:label xml:lang="en">adjacent to</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#approvedOn">
        <rdfs:comment xml:lang="de">Beziehung, die angibt, wann eine Entität genehmigt wurde.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver, hvornår en entitet blev godkendt.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique quand une entité a été approuvée.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica quando un&apos;entità è stata approvata.</rdfs:comment>
        <rdfs:comment>Relationship that specifies when an entity was approved.</rdfs:comment>
        <rdfs:label xml:lang="fr">approuvé le</rdfs:label>
        <rdfs:label xml:lang="it">approvato il</rdfs:label>
        <rdfs:label xml:lang="en">approved on</rdfs:label>
        <rdfs:label xml:lang="de">genehmigt am</rdfs:label>
        <rdfs:label xml:lang="da">godkendt den</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#associatedWith">
        <rdfs:comment xml:lang="de">Beziehung, die starke oder lose Assoziationen zwischen Entitäten beschreibt.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der beskriver stærke eller løse associationer mellem entiteter.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui décrit des associations fortes ou faibles entre des entités.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che descrive associazioni forti o deboli tra entità.</rdfs:comment>
        <rdfs:comment>Relationship that describes strong or loose associations between entities.</rdfs:comment>
        <rdfs:label xml:lang="en">associated with</rdfs:label>
        <rdfs:label xml:lang="it">associato a</rdfs:label>
        <rdfs:label xml:lang="da">associeret med</rdfs:label>
        <rdfs:label xml:lang="fr">associé à</rdfs:label>
        <rdfs:label xml:lang="de">assoziiert mit</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#author">
        <rdfs:comment>Relationship that specifies that a person or organization is an author of the entity.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#buildingContainsStorey">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that indicates that a building contains a floor.</rdfs:comment>
        <rdfs:label xml:lang="en">building contains storey</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contains">
        <rdfs:comment xml:lang="da">Overordnet relation der angiver, at en entitet er en del af noget større.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau indiquant qu&apos;une entité fait partie d&apos;un ensemble plus grand.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello che indica che un&apos;entità fa parte di qualcosa di più grande.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung, die angibt, dass eine Entität Teil von etwas Größerem ist.</rdfs:comment>
        <rdfs:comment>Top level relationship that indicates that an entity is part of a larger thing.</rdfs:comment>
        <rdfs:label xml:lang="en">contains</rdfs:label>
        <rdfs:label xml:lang="it">contiene</rdfs:label>
        <rdfs:label xml:lang="fr">contient</rdfs:label>
        <rdfs:label xml:lang="de">enthält</rdfs:label>
        <rdfs:label xml:lang="da">indeholder</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractGovernedByJurisdiction">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. A jurisdiction that governs the contract.</rdfs:comment>
        <rdfs:label xml:lang="en">contract governed by jurisdiction</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractHasEndDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:endsOn instead. Relationship that specifies the date that a contract is terminated.</rdfs:comment>
        <rdfs:label xml:lang="en">contract has end date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractHasSignatureDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:signedOn instead. Relationship that specifies the signature date of a contract.</rdfs:comment>
        <rdfs:label xml:lang="en">contract has signature date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractHasStartDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:effectiveOn instead. Relationship that specifies the date that a contract becomes effective.</rdfs:comment>
        <rdfs:label xml:lang="en">contract has start date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractInvolvesParty">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. A person or organization is a part of the contract agreement.</rdfs:comment>
        <rdfs:label xml:lang="en">contract involves party</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractMentionsBuiltAsset">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. A built asset is a part of the contract agreement.</rdfs:comment>
        <rdfs:label xml:lang="en">contract mentions built asset</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#contractStatesObligation">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. The contract involves a certain obligation.</rdfs:comment>
        <rdfs:label xml:lang="en">contract states obligation</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#createdOn">
        <rdfs:comment xml:lang="de">Beziehung, die angibt, wann eine Entität erstellt wurde.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver, hvornår en entitet blev oprettet.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique quand une entité a été créée.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica quando un&apos;entità è stata creata.</rdfs:comment>
        <rdfs:comment>Relationship that specifies when an entity was created.</rdfs:comment>
        <rdfs:label xml:lang="en">created on</rdfs:label>
        <rdfs:label xml:lang="it">creato il</rdfs:label>
        <rdfs:label xml:lang="fr">créé le</rdfs:label>
        <rdfs:label xml:lang="de">erstellt am</rdfs:label>
        <rdfs:label xml:lang="da">oprettet den</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingApprovedBy">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:reviewer instead. Relationship that specifies the entity that approved a drawing entity or drawing sheet.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing approved by</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingCreatedBy">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:author instead. Relationship that specifies the creator of a drawing entity or drawing sheet.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing created by</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingHasApprovalDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:approvedOn instead. Relationship that specifies the date that a drawing was approved.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing has approval date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingHasCreationDate">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:createdOn instead. Relationship that specifies the date that a drawing was created.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing has creation date</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingHasFileReference">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that states that the drawing contains a reference to a file.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing has file references</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingHasOrientation">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship that specifies the orientation of a drawing entity.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing has orientation</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#drawingHasScale">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship that specifies the scale of a drawing entity or a drawing sheet.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing has scale</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#effectiveOn">
        <rdfs:comment xml:lang="de">Beziehung, die angibt, wann eine Entität wirksam oder aktiv wird.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver, hvornår en entitet bliver gældende eller aktiv.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique quand une entité devient effective ou active.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica quando un&apos;entità diventa efficace o attiva.</rdfs:comment>
        <rdfs:comment>Relationship that specifies when an entity becomes effective or active.</rdfs:comment>
        <rdfs:label xml:lang="en">effective on</rdfs:label>
        <rdfs:label xml:lang="it">efficace dal</rdfs:label>
        <rdfs:label xml:lang="da">gældende fra</rdfs:label>
        <rdfs:label xml:lang="fr">prend effet le</rdfs:label>
        <rdfs:label xml:lang="de">wirksam ab</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#elementHasMaterial">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship between a building element and a material.</rdfs:comment>
        <rdfs:label xml:lang="en">element has material</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#endsOn">
        <rdfs:comment xml:lang="de">Beziehung, die das End-, Beendigungs- oder Ablaufdatum einer Entität angibt.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver slut-, ophørs- eller udløbsdatoen for en entitet.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique la date de fin, de résiliation ou d&apos;expiration d&apos;une entité.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica la data di fine, cessazione o scadenza di un&apos;entità.</rdfs:comment>
        <rdfs:comment>Relationship that specifies the end, termination, or expiration date of an entity.</rdfs:comment>
        <rdfs:label xml:lang="de">endet am</rdfs:label>
        <rdfs:label xml:lang="en">ends on</rdfs:label>
        <rdfs:label xml:lang="fr">se termine le</rdfs:label>
        <rdfs:label xml:lang="da">slutter den</rdfs:label>
        <rdfs:label xml:lang="it">termina il</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#expressedBy">
        <rdfs:comment xml:lang="da">Overordnet relation der udtrykker en egenskab eller kvalitet ved en entitet (fx at en tegning udtrykkes ved sin målestok, orientering osv.).</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau qui exprime une caractéristique ou une qualité d&apos;une entité (par ex. un dessin est exprimé par son échelle, son orientation, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello che esprime una caratteristica o qualità di un&apos;entità (ad esempio un disegno è espresso dalla sua scala, orientamento, ecc.).</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung, die eine Eigenschaft oder Qualität einer Entität ausdrückt (z. B. wird eine Zeichnung durch Maßstab, Ausrichtung usw. ausgedrückt).</rdfs:comment>
        <rdfs:comment>Top level relationship that expresses a characteristic or quality of an entity (eg. a drawing is expressed by its scale, orientation etc.).</rdfs:comment>
        <rdfs:label xml:lang="de">ausgedrückt durch</rdfs:label>
        <rdfs:label xml:lang="it">espresso da</rdfs:label>
        <rdfs:label xml:lang="en">expressed by</rdfs:label>
        <rdfs:label xml:lang="fr">exprimé par</rdfs:label>
        <rdfs:label xml:lang="da">udtrykt ved</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasActivityAgent">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. Relationship between an agent (Person, Organization) and an Activity.</rdfs:comment>
        <rdfs:label xml:lang="en">has activity agent</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasAssociatedDiscipline">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that specifies the discipline associated with a drawing entity or a drawing sheet.</rdfs:comment>
        <rdfs:label xml:lang="en">has associated discipline</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasContractRole">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship stating that a person or organization has a role in the contract.</rdfs:comment>
        <rdfs:label xml:lang="en">has contract role</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasDesignMetadata">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship that links design metadata to a drawing sheet or drawing entity.</rdfs:comment>
        <rdfs:label xml:lang="en">has design metadata</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasDuration">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship that specifies the duration of an activity.</rdfs:comment>
        <rdfs:label xml:lang="en">has duration</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasEmailAddress">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that states that an email address belongs to a person or an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">has email address</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasEmailReceiver">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that specifies the receiving email address of an email file.</rdfs:comment>
        <rdfs:label xml:lang="en">has email receiver</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasEmailSender">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that specifies the sending email address of an email file.</rdfs:comment>
        <rdfs:label xml:lang="en">has email sender</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasLocation">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:associatedWith instead. Relationship that states that an entity has a physical location.</rdfs:comment>
        <rdfs:label xml:lang="en">has location</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasSubElement">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship between an element and a sub-element. For example a fan in an air handling unit.</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-element</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasTemporalMarker">
        <rdfs:comment xml:lang="da">Overordnet relation for tidslig kvalificering af en entitet på tværs af livscyklus-, juridiske- og proceskontekster.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau pour la qualification temporelle d&apos;une entité dans des contextes de cycle de vie, juridiques et de processus.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello per la qualificazione temporale di un&apos;entità nei contesti di ciclo di vita, legali e di processo.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung zur zeitlichen Qualifizierung einer Entität über Lebenszyklus-, rechtliche und Prozesskontexte hinweg.</rdfs:comment>
        <rdfs:comment>Top level relationship for temporal qualification of an entity across lifecycle, legal, and process contexts.</rdfs:comment>
        <rdfs:label xml:lang="fr">a un marqueur temporel</rdfs:label>
        <rdfs:label xml:lang="it">ha un marcatore temporale</rdfs:label>
        <rdfs:label xml:lang="da">har tidsmarkør</rdfs:label>
        <rdfs:label xml:lang="en">has temporal marker</rdfs:label>
        <rdfs:label xml:lang="de">hat zeitliche Markierung</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#ifcPSet">
        <rdfs:comment xml:lang="en">The name of the Property Set in the IFC file. Official PSets are considered higher quality and SHACL shapes can be applied to evaluate the BIM model quality.</rdfs:comment>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#includesActivity">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that specifies that an activity is part of a schedule / project-plan.</rdfs:comment>
        <rdfs:label xml:lang="en">includes activity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#includesBuildingEntity">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that states that the drawing entity includes a building zone or a building element.</rdfs:comment>
        <rdfs:label xml:lang="en">includes building entity</rdfs:label>
