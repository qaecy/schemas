        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Abstract property that connects something with its categories. Use one of the more specific sub-properties to assign categories.</rdfs:comment>
        <rdfs:label xml:lang="en">has category</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasContentCategory -->


