        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:interfaces with the Adjacent relation category instead.</rdfs:comment>
        <rdfs:label xml:lang="en">adjacent to</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#alternativeRepresentation -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#alternativeRepresentation">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between two information objects where one is an alternative representation of the other. For example an image derived from a PDF page fragment or a CAD drawing.</rdfs:comment>
        <rdfs:label xml:lang="en">alternative representation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#approvedOn -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#approvedOn">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasTemporalMarker"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="de">Beziehung, die angibt, wann eine Entität genehmigt wurde.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver, hvornår en entitet blev godkendt.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique quand une entité a été approuvée.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica quando un&apos;entità è stata approvata.</rdfs:comment>
        <rdfs:comment>Relationship that specifies when an entity was approved.</rdfs:comment>
        <rdfs:label xml:lang="fr">approuvé le</rdfs:label>
        <rdfs:label xml:lang="it">approvato il</rdfs:label>
        <rdfs:label xml:lang="en">approved on</rdfs:label>
        <rdfs:label xml:lang="de">genehmigt am</rdfs:label>
        <rdfs:label xml:lang="da">godkendt den</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#associatedWith -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#associatedWith">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="de">Beziehung, die starke oder lose Assoziationen zwischen Entitäten beschreibt.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der beskriver stærke eller løse associationer mellem entiteter.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui décrit des associations fortes ou faibles entre des entités.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che descrive associazioni forti o deboli tra entità.</rdfs:comment>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:interfaces instead.</rdfs:comment>
        <rdfs:label xml:lang="en">associated with</rdfs:label>
        <rdfs:label xml:lang="it">associato a</rdfs:label>
        <rdfs:label xml:lang="da">associeret med</rdfs:label>
        <rdfs:label xml:lang="fr">associé à</rdfs:label>
        <rdfs:label xml:lang="de">assoziiert mit</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#author -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#author">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#involves"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>Relationship that specifies that a person or organization is an author of the entity.</rdfs:comment>
        <rdfs:label xml:lang="en">author</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Organization"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Person"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#DrawingEntity"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#DrawingSheet"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#buildingContainsStorey -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#buildingContainsStorey">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#contains -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#contains">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="da">Overordnet relation der angiver, at en entitet er en del af noget større.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation de haut niveau indiquant qu&apos;une entité fait partie d&apos;un ensemble plus grand.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione di alto livello che indica che un&apos;entità fa parte di qualcosa di più grande.</rdfs:comment>
        <rdfs:comment xml:lang="de">Übergeordnete Beziehung, die angibt, dass eine Entität Teil von etwas Größerem ist.</rdfs:comment>
        <rdfs:comment>Top level relationship that indicates that an entity is part of a larger thing.</rdfs:comment>
        <rdfs:label xml:lang="en">contains</rdfs:label>
        <rdfs:label xml:lang="it">contiene</rdfs:label>
        <rdfs:label xml:lang="fr">contient</rdfs:label>
        <rdfs:label xml:lang="de">enthält</rdfs:label>
        <rdfs:label xml:lang="da">indeholder</rdfs:label>
        <template:extractionPrompt>A is made up of B. B cannot exist on its own - remove A and B is meaningless.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#containsFragment -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#containsFragment">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#implicitlyContainsFragment"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment>Relationship between a qcy:InformationObject and one of its qcy:Fragments</rdfs:comment>
        <rdfs:label xml:lang="en">contains fragment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#contractGovernedByJurisdiction -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#contractGovernedByJurisdiction">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#involves"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. A jurisdiction that governs the contract.</rdfs:comment>
        <rdfs:label xml:lang="en">contract governed by jurisdiction</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ContractualDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Organization"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Contract"/>
        <template:extractionPrompt>A &apos;Contract&apos; is governed by a certain &apos;Jurisdiction&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


