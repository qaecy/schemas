        <schema:rangeIncludes rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <schema:rangeIncludes rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <schema:rangeIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between a qcy:Selector and the thing it specifies. This is typically a qcy:EntityMention (eg this part of the text mentions the entity), a qcy:InformationObject (eg this picture is placed here on the page) or a qcy:CanonicalEntity (eg this part of the file path names this entity).</rdfs:comment>
        <rdfs:label xml:lang="en">selector object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#selectorSubject -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#selectorSubject">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <schema:rangeIncludes rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <schema:rangeIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between a qcy:Selector and the thing it specifies a location within. This is typically a qcy:InformationObject, but it can also be a qcy:FileLocation - a qcy:FilePathSelector points at a range of that location&apos;s qcy:filePath, and a qcy:RecordFieldSelector at the field of a register that described it. Stated with schema:rangeIncludes rather than rdfs:range because qcy:FileLocation and qcy:InformationObject are disjoint, so a single rdfs:range would make every file-location selector an inconsistency.</rdfs:comment>
        <rdfs:label xml:lang="en">selector subject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#sheetContainsDrawing -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#sheetContainsDrawing">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. A drawing sheet contains a drawing entity.</rdfs:comment>
        <rdfs:label xml:lang="en">drawing sheet contains drawing entity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#DrawingEntity"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#DrawingSheet"/>
        <template:extractionPrompt>A &apos;DrawingSheet&apos; contains a &apos;DrawingEntity&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#signedOn -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#signedOn">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasTemporalMarker"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="de">Beziehung, die das Unterzeichnungsdatum einer Entität angibt, z. B. eines Vertrags.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver underskriftsdatoen for en entitet, f.eks. en kontrakt.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique la date de signature d&apos;une entité, par exemple un contrat.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica la data di firma di un&apos;entità, ad esempio un contratto.</rdfs:comment>
        <rdfs:comment>Relationship that specifies the signature date of an entity such as a contract.</rdfs:comment>
        <rdfs:label xml:lang="it">firmato il</rdfs:label>
        <rdfs:label xml:lang="en">signed on</rdfs:label>
        <rdfs:label xml:lang="fr">signé le</rdfs:label>
        <rdfs:label xml:lang="da">underskrevet den</rdfs:label>
        <rdfs:label xml:lang="de">unterzeichnet am</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#similarTo -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#similarTo">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Relationship between a qcy:CanonicalEntity and any other representation of the same entity (for example the Wikidata entry) or a similar entity (for example the OpenStreetMaps street address of an appartment in a building). This property indicates that the canonical entity can be linked to or identified with another entity in a different context or dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">similar to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#siteContainsBuilding -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#siteContainsBuilding">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#splitFrom -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#splitFrom">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:comment xml:lang="en">Inverse of qcy:splitInto: a newly minted qcy:CanonicalEntity records the entity it was separated out of, preserving provenance for a decision that cannot be expressed as a redirect.</rdfs:comment>
        <rdfs:label xml:lang="en">split from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#splitInto -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#splitInto">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:comment xml:lang="en">Relationship from a qcy:CanonicalEntity that was found to conflate several real-world entities, to each of the entities it was separated into. The largest fragment retains the original identifier and therefore appears as both subject and object.</rdfs:comment>
        <rdfs:label xml:lang="en">split into</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#startsOn -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#startsOn">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#hasTemporalMarker"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="de">Beziehung, die das Startdatum einer Entität in einem Prozesskontext angibt.</rdfs:comment>
        <rdfs:comment xml:lang="da">Relation der angiver startdatoen for en entitet i en proceskontekst.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Relation qui indique la date de début d&apos;une entité dans un contexte de processus.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che indica la data di inizio di un&apos;entità in un contesto di processo.</rdfs:comment>
        <rdfs:comment>Relationship that specifies the start date of an entity in a process context.</rdfs:comment>
        <rdfs:label xml:lang="de">beginnt am</rdfs:label>
        <rdfs:label xml:lang="fr">commence le</rdfs:label>
        <rdfs:label xml:lang="it">inizia il</rdfs:label>
        <rdfs:label xml:lang="da">starter den</rdfs:label>
        <rdfs:label xml:lang="en">starts on</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#zoneContainsElement -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#zoneContainsElement">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#zoneContainsSpace -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#zoneContainsSpace">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#zoneHasAdjacentElement -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#zoneHasAdjacentElement">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#adjacentTo"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#zoneHasElement -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#zoneHasElement">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#contains"/>
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://dev.qaecy.com/ont#confidence -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#confidence">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numerical score, typically between 0.0 and 1.0, representing the level of certainty or belief in an assertion, a piece of data, or a relationship. For example, the confidence that an entity mention resolves to a particular canonical entity, or the confidence in the derived properties of a canonical entity.</rdfs:comment>
        <rdfs:label xml:lang="en">confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#dateCreated -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#dateCreated">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time when the resource was created. This is typically the time when the resource was first stored in the database or in the source system.</rdfs:comment>
        <rdfs:label xml:lang="en">date created</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#dateDeleted -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#dateDeleted">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time when the resource was deleted. This is typically the time when the resource was removed from the database or in the source system.</rdfs:comment>
        <rdfs:label xml:lang="en">date deleted</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#dateModified -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#dateModified">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date and time when the resource was last modified. This is typically the time when the resource was last updated in the database or in the source system.</rdfs:comment>
        <rdfs:label xml:lang="en">date modified</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#decidedBy -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#decidedBy">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Who authored an identity decision — a person, an agent, or the resolver itself. Human and agent decisions are recorded so that they can be recognised, audited, and protected from being undone by automatic passes.</rdfs:comment>
        <rdfs:label xml:lang="en">decided by</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#description -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#description">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:comment xml:lang="en">Text situating a thing in the context it was found in, so that it can be interpreted without returning to the source. On a qcy:EntityMention or qcy:CanonicalEntity this is what distinguishes it from a similarly named one elsewhere - what contains it, which revision or party it belongs to, the role it plays. Written either by a Large Language model at extraction time, where it is kept under ~50 words, or by a processor summarising a source record, where it may be considerably longer. Consumers that feed it to a model should expect the latter and truncate.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#enrichmentAttemptCount -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#enrichmentAttemptCount">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of times enrichment has been attempted for this canonical entity. Used to limit retry attempts for enrichment processes (e.g., geocoding addresses). After a maximum number of attempts, the entity is no longer considered for enrichment.</rdfs:comment>
        <rdfs:label xml:lang="en">enrichment attempt count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#explicit -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#explicit">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">A boolean property specifying that something is explicit. It is specifically used to indicate that a qcy:CanonicalEntity has been confirmed by an authorized project practitioner or other specialist.</rdfs:comment>
        <rdfs:label xml:lang="en">explicit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#extractedWithSchemaRevision -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#extractedWithSchemaRevision">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">The revision of the project schema the document&apos;s semantic extraction last ran with. A schema revision newer than this means categories added since were not looked for.</rdfs:comment>
        <rdfs:label xml:lang="en">extracted with schema revision</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#filePath -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#filePath">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The file path property specifies the location of a file within its qcy:FileProvider. For a local device it is the absolute path on that machine, normalised to forward slashes (e.g. &quot;/Users/anna/Projects/Nest/A-101.pdf&quot; or &quot;C:/Projects/Nest/A-101.pdf&quot;). For other providers it is the path as the provider presents it.</rdfs:comment>
        <rdfs:label xml:lang="en">file path</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#ifcPSet -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#ifcPSet">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#inferredFragmentType -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#inferredFragmentType">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Text value that provides more information about what type of fragment. Typically inferred by libraries like Unstructured.</rdfs:comment>
        <rdfs:label xml:lang="en">inferred fragment type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#label -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#label">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <rdfs:comment xml:lang="en">A label is a human-readable name for the resource. Each resource should have only one preferred label in english that specifies the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">label</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#language -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#language">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">ISO 639 two letter language code</rdfs:comment>
        <rdfs:label xml:lang="en">language</rdfs:label>
        <template:regex>^[a-z]{2}$</template:regex>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#md5Hash -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#md5Hash">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The 32 character MD5 hash in lower case hexadecimals (empty string = d41d8cd98f00b204e9800998ecf8427e)</rdfs:comment>
        <rdfs:label xml:lang="en">MD5 hash</rdfs:label>
        <template:regex>^[a-f0-9]{32}$</template:regex>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#md5HashBase64 -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#md5HashBase64">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The 24 character MD5 hash in Base64 encoding (empty string = 1B2M2Y8AsgTpgAmY7PhCfg==)</rdfs:comment>
        <rdfs:label xml:lang="en">MD5 hash Base 64</rdfs:label>
        <template:regex>^[a-zA-Z0-9+/=]{24}$</template:regex>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#mime -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#mime">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <terms:conformsTo rdf:resource="https://www.iana.org/assignments/media-types/media-types.xhtml"/>
        <rdfs:comment xml:lang="en">The mimetype of the file content preferably in accordance with IANA but also commonly used mimetypes in the AEC industry are accepted (eg. application/x-step for an IFC in STEP format)</rdfs:comment>
        <rdfs:label xml:lang="en">mime</rdfs:label>
        <template:regex>^[a-z]+/[a-z0-9-]+$</template:regex>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#openFormat -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#openFormat">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Is the file content readable without proprietary software tools?</rdfs:comment>
        <rdfs:label xml:lang="en">open format</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#ownerUid -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#ownerUid">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileProvider"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The user id of the person a qcy:FileProvider belongs to, such as the owner of a local device. Not set for shared sources like a document management system.</rdfs:comment>
        <rdfs:label xml:lang="en">owner uid</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#platform -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#platform">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileProvider"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The operating system of a local device qcy:FileProvider (&quot;darwin&quot;, &quot;win32&quot; or &quot;linux&quot;), used to present its qcy:filePath values the way that machine shows them.</rdfs:comment>
        <rdfs:label xml:lang="en">platform</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#reasoning -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#reasoning">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A textual explanation or justification supporting an assertion, a piece of data, a derived value, or a relationship. This can include the evidence, logic, or process used to arrive at a conclusion or to assign a confidence score.</rdfs:comment>
        <rdfs:label xml:lang="en">reasoning</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#remoteProviderId -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#remoteProviderId">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A unique identifier used to identify the remote provider. This is part of the fileUUID and is used uniquely identify a resource in relation to the remote system.</rdfs:comment>
        <rdfs:label xml:lang="en">remote provider id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#remoteProviderType -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#remoteProviderType"/>
    


    <!-- https://dev.qaecy.com/ont#remoteRelativePath -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#remoteRelativePath">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The remote relative path specifies the location of a file on a storage system. This is always a relative path in relation to the project directory on a cloud storage provider.</rdfs:comment>
        <rdfs:label xml:lang="en">remote relative path</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#resolutionAttemptCount -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#resolutionAttemptCount">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The number of times resolution has been attempted for this entity mention. Used to limit retry attempts for entity resolution processes. After a maximum number of attempts, the mention is no longer considered for resolution to a canonical entity.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution attempt count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#resolutionScopeKey -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#resolutionScopeKey">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The resolved scope a qcy:CanonicalEntity was minted under - the identifiers of its scoping parents, as used in its deterministic identifier. Storey &quot;1&quot; of one building and storey &quot;1&quot; of another are distinct entities carrying the same value, and this is what separates them once they are read back out of the graph: without it a candidate retrieved by similarity carries no scope, and a scope conflict cannot be detected. Empty for categories whose identity does not depend on a containing entity.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution scope key</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#resolutionStatus -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#resolutionStatus">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A terminal, non-resolving outcome for a qcy:EntityMention. &quot;noise&quot; means the value failed its category&apos;s validation and is not a usable entity reference; &quot;ambiguous&quot; means resolution declined to choose among candidates and the mention awaits human review. A mention with this property is not reconsidered by routine resolution.</rdfs:comment>
        <rdfs:label xml:lang="en">resolution status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#resolvedForm -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#resolvedForm">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A surface form that was judged to denote this qcy:CanonicalEntity but does not normalize to its value - an alias, a translation, an abbreviation. The identifier of a canonical entity is derived from its own normalized value, so a form that merges into it leaves no trace under its own identifier and the cheap identity probe cannot find it again: every later occurrence of that form would be re-adjudicated from scratch, at the same cost, forever. Recording the form here makes the second occurrence free. Values are the same deterministic form identifier the probe computes.</rdfs:comment>
        <rdfs:label xml:lang="en">resolved form</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#sizeBytes -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#sizeBytes">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileContent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The size of the file content in bytes</rdfs:comment>
        <rdfs:label xml:lang="en">size bytes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#subject -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#subject">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">A subject is a short description that captures the main theme or topic of a qcy:InformationObject. The subject is typically generated by a Large Language model.</rdfs:comment>
        <rdfs:label xml:lang="en">subject</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#suffix -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#suffix">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The file suffix including dot (ex: &quot;.pdf&quot;)</rdfs:comment>
        <rdfs:label xml:lang="en">file suffix</rdfs:label>
        <template:regex>^\.[a-z0-9]+$</template:regex>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#tableContent -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#tableContent">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#TableFragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">&quot;Processed table output, which contains a json string with the content assigned to the cells, as extracted from the input..</rdfs:comment>
        <rdfs:label xml:lang="en">table grid content</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#tableGrid -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#tableGrid">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#TableFragment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Processed table output, which contains a json string with a grid of cells, as extracted from the input.</rdfs:comment>
        <rdfs:label xml:lang="en">table grid</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#tag -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#tag">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">A tag is a keyword or term assigned to a piece of information, such as a qcy:InformationObject, to describe and categorize it. Tags are typically used to facilitate searching and organizing information. An information object can have multiple tags.</rdfs:comment>
        <rdfs:label xml:lang="en">tag</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#textRaw -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#textRaw">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Raw text as extracted from the qcy:InformationObject.</rdfs:comment>
        <rdfs:label xml:lang="en">text raw</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#textSummary -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#textSummary">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">A short text that summarizes all information about the thing. This is typically generated by a Large Language model from provided context any form.</rdfs:comment>
        <rdfs:label xml:lang="en">text summary</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://dev.qaecy.com/ont#value -->


    <owl:DatatypeProperty rdf:about="https://dev.qaecy.com/ont#value">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <schema:domainIncludes rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A value is a text string that holds the value. How to interpret this value depends on what the value is assigned to.</rdfs:comment>
        <rdfs:label xml:lang="en">value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2002/07/owl#ObjectProperty -->


    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    


    <!-- https://dev.qaecy.com/ont#BIMEntity -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#BIMEntity">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:comment xml:lang="en">A BIM entity is a special kind of entity mention. It&apos;s an intangible (zone) or tangible (element) part of a BIM model.</rdfs:comment>
        <rdfs:label xml:lang="en">BIM Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CADLayoutFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CADLayoutFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes a CAD layout. It should be specified with a selector (qcy:CADLayoutSelector) relative to its parent fragment and the extracted layout&apos;s location should be specified.</rdfs:comment>
        <rdfs:label xml:lang="en">CAD Layout Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CADLayoutSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CADLayoutSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A CAD layout selector specifies the name of a layout in a CAD file. It should be used to connect a qcy:FileContent object representing a CAD file with a qcy:Fragment representing the layout. The value is the name of the layout as specified in the CAD file and corresponds to the block parameter used when extracting an image of the CAD layout using QCAD.</rdfs:comment>
        <rdfs:label xml:lang="en">CAD Layout Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CADViewportFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CADViewportFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes a CAD viewport. It should be specified with a selector (qcy:CADViewportSelector) relative to its parent fragment and the extracted viewport&apos;s location should be specified.</rdfs:comment>
        <rdfs:label xml:lang="en">CAD Viewport Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CADViewportSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CADViewportSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A CAD viewport selector specifies the location of a viewport in a CAD layout. It should be used to connect a qcy:FileContent object representing a CAD layout with a qcy:Fragment representing the viewport. The value is the XYWH coordinates of the viewport within the cartesian coordinate system of the CAD layout (Y axis pointing upwards) normalised to mm. The value corresponds to the window parameter (-w) that is fed to QCAD when extracting an image of the CAD layout and is always.</rdfs:comment>
        <rdfs:label xml:lang="en">CAD Viewport Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CanonicalEntity -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CanonicalEntity">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:comment xml:lang="en">These are standardized representations of named entities that are the output of an enrichment step in the QAECY pipelines. The entity resolution should include relevant contextual information to distinguish between unique named entities. For example, there can be a ground floor in two buildings but they are not the same concept.</rdfs:comment>
        <rdfs:label xml:lang="en">Canonical Entity</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#Category -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#Category">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#FileProvider"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">Abstract class for specific categories that each hold enumerations used for specification of information objects and entity references. It is recommended to use SKOS to establish more context between the Category entities.</rdfs:comment>
        <rdfs:label xml:lang="en">Category</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#ContentCategory -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#ContentCategory">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category derived from the content of the file</rdfs:comment>
        <rdfs:label xml:lang="en">Content Category</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#CoordinateTranslator -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#CoordinateTranslator">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A coordinate translator specifies the parameters needed to translate coordinates from one coordinate system to another. This is used to connect a qcy:Fragment representing a CAD layout with a qcy:Fragment representing an image of that layout, to enable translation of the viewport coordinates in the CAD layout to XYWH coordinates in the image. The value is formatted as an SVG transformation matrix (eg. matrix(56.69, 0, 0, -56.69, 110.07, 257.10))</rdfs:comment>
        <rdfs:label xml:lang="en">Coordinate Translator</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#DocumentPageFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#DocumentPageFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes a page in a paginated document.</rdfs:comment>
        <rdfs:label xml:lang="en">Document Page Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#DocumentTextSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#DocumentTextSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A document text selector names which text of a document a link was read from, rather than a position within it. The value is the name of that text - for example \&quot;summary\&quot; for a generated summary of the document, or \&quot;text\&quot; for its extracted body text. It is the counterpart of qcy:FilePathSelector and qcy:RecordFieldSelector for claims that come from what a document says rather than from what it is called or how a register lists it, and exists because a match found by scanning a whole document in chunks has no single position that would survive re-extraction.</rdfs:comment>
        <rdfs:label xml:lang="en">Document Text Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#EntityCategory -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#EntityCategory">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category that specifies the categories of an entity reference</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Category</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#EntityMention -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#EntityMention">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:comment xml:lang="en">An entity mention is an occurrence of a specific entity within a qcy:InformationObject. Each occurrence is unique, meaning that two mentions of &quot;Albert Einstein&quot; in the same information object are considered two distinct entity mentions. Entity mentions can describe mentionings of persons, organizations, locations, dates, and other proper nouns.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Mention</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#EntityPrototype -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#EntityPrototype">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#EntityMention"/>
        <rdfs:comment xml:lang="en">A type object rather than an occurrence of one: the IFC type a door instance inherits its shared properties from, written by ifc-processor and pointed at by qcy:inheritsFrom. It is a qcy:EntityMention like any other - it carries a value and categories - but entity resolution never merges a prototype with an occurrence, however alike &quot;Door Type A&quot; and &quot;Door Type A 001&quot; look.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Prototype</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#EntityReference -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#EntityReference">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#FileLocation"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#FileProvider"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">This abstract class captures reference points for all features of interest in a project, such as a building element, a zone, a person, or material. These references can be either explicit or potential occurrences of the entity. This class should not be assigned directly; instead, use the sub-class qcy:EntityMention for potential occurrences of an entity and qcy:CanonicalEntity for a formalized entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Entity Reference</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#FileContent -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#FileContent">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">A file content object represents the full content of a qcy:File. It is uniquely identified by its content, meaning that any modification, even a single character change, results in a new file content object. This ensures that each file content object is immutable and uniquely identifiable. Additionally, a single file content object can be referenced by multiple qcy:File instances, which may be stored in different locations, either locally or in the cloud.</rdfs:comment>
        <rdfs:label xml:lang="en">File Content</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#FileLocation -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#FileLocation">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#FileProvider"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A file location is a digital representation of an information object that is stored on a hard drive, either locally or in the cloud.</rdfs:comment>
        <rdfs:label xml:lang="en">File Location</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#FilePathSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#FilePathSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#TextIndexSelector"/>
        <rdfs:comment xml:lang="en">A file path selector specifies a range within the qcy:filePath of the qcy:FileLocation it is the selector subject of, formatted as start and end separated by a comma (\&quot;start,end\&quot;) like qcy:TextIndexSelector. It records that the selector object was derived from that part of the path - typically a classification code a project encodes in its filenames - and is what makes it possible to tell afterwards which segment of which name a link came from.</rdfs:comment>
        <rdfs:label xml:lang="en">File Path Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#FileProvider -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#FileProvider">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A file provider is a source that qcy:FileLocation instances come from, such as one user&apos;s computer, a user&apos;s browser uploads or a document management system like SharePoint. It is identified within a project by its qcy:remoteProviderId, which every qcy:FileLocation from that source shares, and it carries a human-readable qcy:label and a qcy:providerKind. The same qcy:FileContent can be found at locations from several providers.</rdfs:comment>
        <rdfs:label xml:lang="en">File Provider</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#Fragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#Fragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment xml:lang="en">A fragment is a subset of a qcy:FileContent object. Each fragment can have sub-fragments in any arbitrary depth (see qcy:containsFragment). For example, a page is a fragment of a document and a text paragraph, image, and table can all be sub-fragments of that page.</rdfs:comment>
        <rdfs:label xml:lang="en">Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#IDSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#IDSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">The value specifies an identifier within a structured document, such as an XML or JSON file. For BIM models use one of the more specific ID selectors for the specific kind of ID. The ID Selector is typically used to identify the location of a qcy:EntityMention by its unique ID.</rdfs:comment>
        <rdfs:label xml:lang="en">ID Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#IFCExpressIDSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#IFCExpressIDSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">The value of an IFC Express ID Selector specifies the ExpressId of the object within the IFC document. Beware that this ID is only unique in context of that single serailization of the model and is likely to change in future versions of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">IFC Express ID Selector</rdfs:label>
        <template:iriPattern>&lt;objectUUID&gt;_expressID</template:iriPattern>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#IFCGlobalIDSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#IFCGlobalIDSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">The value of an IFC Global ID Selector specifies the GlobalId of the object within the IFC document.</rdfs:comment>
        <rdfs:label xml:lang="en">IFC Global ID Selector</rdfs:label>
        <template:iriPattern>&lt;objectUUID&gt;_globalID</template:iriPattern>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#ImageFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#ImageFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes an image. It should be specified with a selector (qcy:XYWHSelector) relative to its parent fragment and the extracted image&apos;s location should be specified.</rdfs:comment>
        <rdfs:label xml:lang="en">Image Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#InformationObject -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#InformationObject">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Property"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">An information object is an abstract class that captures all information found in project files. It can either be the full content of the file (see qcy:FileContent) or a subset (see qcy:Fragment). This abstract class should not be defined explicitly, so instead use one of the more specific sub-classes.</rdfs:comment>
        <rdfs:label xml:lang="en">Information Object</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#MimeCategory -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#MimeCategory">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category derived from the mimetype of the file content</rdfs:comment>
        <rdfs:label xml:lang="en">Mime Category</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#PageSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#PageSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A page selector specifies a particular page within a document. This special selector always always connects a qcy:FileContent object with a qcy:DocumentPage. The value is the page number starting from 1.</rdfs:comment>
        <rdfs:label xml:lang="en">Page Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#Property -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#Property">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#RelationMeta"/>
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">Any quantitative or qualitative property of an entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Property</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#ProviderKind -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#ProviderKind">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category that specifies what kind of source a qcy:FileProvider is, for example a local device, browser uploads or a document management system.</rdfs:comment>
        <rdfs:label xml:lang="en">Provider Kind</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#ProviderType -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#ProviderType">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category that specifies the type of provider</rdfs:comment>
        <rdfs:label xml:lang="en">Provider Type</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#RecordFieldSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#RecordFieldSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A record field selector specifies a named field within a tabular or otherwise keyed record, such as a column of a spreadsheet or a key of a JSON object. The value is the field name as it appears in the record. It records that the selector object was derived from that field, which is what makes it possible to tell afterwards whether a file was described by its name or by a column of a register, and to compare the two.</rdfs:comment>
        <rdfs:label xml:lang="en">Record Field Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#RelationCategory -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#RelationCategory">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Category"/>
        <rdfs:comment>Category that specifies the role or type of a relationship described by a qcy:RelationMeta node. Instances are SKOS concepts that qualify top-level relationships such as qcy:involves (e.g. Author, Reviewer).</rdfs:comment>
        <rdfs:label xml:lang="en">Relation Category</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#RelationMeta -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#RelationMeta">
        <owl:disjointWith rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment>A reification node that further qualifies a relationship between two entities. It specifies the subject and object together with a qcy:RelationCategory and optionally the predicate being qualified via qcy:hasRelationMetaProperty. It can qualify any sub-property of qcy:relatedEntity (e.g. qcy:involves, qcy:contains, qcy:leadsTo). This is used when the top-level property alone is insufficient to express the full semantics (e.g. to distinguish that John is the author of drawing A but the reviewer of drawing B).</rdfs:comment>
        <rdfs:label xml:lang="en">Relation Meta</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#Selector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#Selector">
        <rdfs:comment xml:lang="en">A selector specifies where in a qcy:InformationObject or a qcy:FileLocation a qcy:EntityReference occurs. For example from/to what index in a text paragraph, what XYWH bounding box on a page, what GlobalId in an IFC file, what range of a file path or what field of a register.</rdfs:comment>
        <rdfs:label xml:lang="en">Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#TableFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#TableFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes a table with rows and columns. It should specified with a selector (qcy:XYWHSelector) relative to its parent fragment and the qcy:tableGrid should be specified.</rdfs:comment>
        <rdfs:label xml:lang="en">Table Fragment</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#TextDirectiveSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#TextDirectiveSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <terms:conformsTo rdf:resource="https://wicg.github.io/scroll-to-text-fragment/"/>
        <rdfs:comment xml:lang="en">A text directive selector specifies a range within a text using the syntax \&quot;#:~:text=[prefix-,]start[,end][,-suffix]\&quot;. For example, \&quot;#:~:text=example,fragment\&quot; would indicate a range from the first occurrence of \&quot;example\&quot; to the next occurrence of \&quot;fragment\&quot;. This is used to identify the exact location of a qcy:EntityMention within a text fragment.</rdfs:comment>
        <rdfs:label xml:lang="en">Text Directive Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#TextFragment -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#TextFragment">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment xml:lang="en">This special fragment constitutes a text extraction. It can be the full text of a page a paragraph, footer, header or the like. Except for the former case, it should specified with a selector (qcy:XYWHSelector) to describe it&apos;s location relative to its parent fragment. It should also specify a qcy:textRaw and optionally a qcy:textFormatted.</rdfs:comment>
        <rdfs:label xml:lang="en">Text Fragment</rdfs:label>
        <template:iriPattern xml:lang="en">&lt;parentUUID&gt;&lt;selectorUUID&gt;</template:iriPattern>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#TextIndexSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#TextIndexSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <rdfs:comment xml:lang="en">A text index selector specifies a range within a text using start and end separated by a comma (\&quot;start,end\&quot;). For example \&quot;6,11\&quot; on the text string \&quot;Hello World\&quot; would specify the subset \&quot;World\&quot;. This is similar to string slicing in Python and is used to identify the exact location of a qcy:EntityMention within a text fragment.</rdfs:comment>
        <rdfs:label xml:lang="en">Text Index Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#TimeRangeSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#TimeRangeSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <terms:conformsTo rdf:resource="http://www.w3.org/TR/media-frags/"/>
        <rdfs:comment xml:lang="en">The value specifies the time range formatted in accordance with http://www.w3.org/TR/media-frags/</rdfs:comment>
        <rdfs:label xml:lang="en">Time Range Selector</rdfs:label>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#XYWHSelector -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#XYWHSelector">
        <rdfs:subClassOf rdf:resource="https://dev.qaecy.com/ont#Selector"/>
        <terms:conformsTo rdf:resource="http://www.w3.org/TR/media-frags/"/>
        <rdfs:comment xml:lang="en">The value specifies the bounding box formatted as an xywh box (http://www.w3.org/TR/media-frags/) either in absolute pixels or relative to the information object. The XYWH Selector is used to identify the location of a qcy:EntityMention or qcy:InformationObject within a visual document.</rdfs:comment>
        <rdfs:label xml:lang="en">XYWH Selector</rdfs:label>
        <template:iriPattern>&lt;objectUUID&gt;&lt;xywhString&gt;</template:iriPattern>
    </owl:Class>
    


    <!-- https://dev.qaecy.com/ont#relatedEntity -->


    <owl:Class rdf:about="https://dev.qaecy.com/ont#relatedEntity"/>
    


