        <template:extractionPrompt>A &apos;Person&apos; or &apos;Organization&apos; undertakes a specific &apos;ContractRole&apos; in the context of the &apos;Contract&apos;.</template:extractionPrompt>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#hasDesignMetadata -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#hasDesignMetadata">
