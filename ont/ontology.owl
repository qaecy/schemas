    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/conformsTo"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://schema.org/domainIncludes -->


    <owl:AnnotationProperty rdf:about="http://schema.org/domainIncludes"/>
    


    <!-- https://dev.qaecy.com/ont#visibleForAgent -->


    <owl:AnnotationProperty rdf:about="https://dev.qaecy.com/ont#visibleForAgent"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://dev.qaecy.com/ont#about -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#about">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#CanonicalEntity"/>
        <rdfs:comment>Relationship between a qcy:InformationObject and a qcy:CanonicalEntity. This property indicates that a file content or fragment is about a specific canonical entity. It can be implicitly derived that if a file content or fragment mentions the occurrence of a named entity, and that named entity resolves to a canonical entity, then the file content or fragment is about the canonical entity.</rdfs:comment>
        <rdfs:label xml:lang="en">about</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</visibleForAgent>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#activityHasEndDate -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#activityHasEndDate">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#endsOn"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#activityHasStartDate -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#activityHasStartDate">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#startsOn"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#adjacentFragment -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#adjacentFragment">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#Fragment"/>
        <rdfs:comment>Relationship between two fragments that are adjacent within the shared parent information object.</rdfs:comment>
        <rdfs:label xml:lang="en">adjacent fragment</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#adjacentTo -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#adjacentTo">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#associatedWith"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityReference"/>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#alternativeRepresentation -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#alternativeRepresentation">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#InformationObject"/>
        <rdfs:comment>Relationship between two information objects where one is an alternative representation of the other. For example an image derived from a PDF page fragment or a CAD drawing.</rdfs:comment>
        <rdfs:label xml:lang="en">alternative representation</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#applicableContentCategories -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#applicableContentCategories">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://dev.qaecy.com/ont#EntityCategory"/>
                    <rdf:Description rdf:about="https://dev.qaecy.com/ont#relatedEntity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#ContentCategory"/>
        <rdfs:comment>Relationship between a qcy:EntityCategory or a qcy:relatedEntity sub-property and one or more qcy:ContentCategory. This property is used to specify the entities that will be represented based on the type of the content.</rdfs:comment>
        <rdfs:label xml:lang="en">applicable content categories</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#applicableObjectCategories -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#applicableObjectCategories">
        <rdfs:domain rdf:resource="https://dev.qaecy.com/ont#relatedEntity"/>
        <rdfs:range rdf:resource="https://dev.qaecy.com/ont#EntityCategory"/>
        <rdfs:comment>Relationship between a qcy:relatedEntity sub-property and one or more qcy:EntityCategory. This property is used to specify the categories that are applicable to the object of the relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">applicable object categories</rdfs:label>
        <visibleForAgent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</visibleForAgent>
    </owl:ObjectProperty>
    


