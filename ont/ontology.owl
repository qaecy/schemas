        <rdfs:label xml:lang="en">adjacent fragment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://dev.qaecy.com/ont#adjacentTo -->


    <owl:ObjectProperty rdf:about="https://dev.qaecy.com/ont#adjacentTo">
        <rdfs:subPropertyOf rdf:resource="https://dev.qaecy.com/ont#interfaces"/>
