     -->


    <rdf:Description rdf:about="https://dev.qaecy.com/ont#buildingContainsStorey">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that indicates that a building contains a floor.</rdfs:comment>
        <rdfs:label xml:lang="en">building contains storey</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Storey"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#elementHasMaterial">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:expressedBy instead. Relationship between a building element and a material.</rdfs:comment>
        <rdfs:label xml:lang="en">element has material</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Material"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:extractionPrompt>A &apos;BuildingElement&apos; is made of some &apos;Material&apos;.</template:extractionPrompt>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#hasSubElement">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship between an element and a sub-element. For example a fan in an air handling unit.</rdfs:comment>
        <rdfs:label xml:lang="en">has sub-element</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#ifcPSet">
        <rdfs:comment xml:lang="en">The name of the Property Set in the IFC file. Official PSets are considered higher quality and SHACL shapes can be applied to evaluate the BIM model quality.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#interfaceOf">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:interfaces directly between the two entities; anything the Interface entity carried belongs on the qcy:RelationMeta for that edge.</rdfs:comment>
        <rdfs:label xml:lang="en">interface of</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#relatedEntity">
        <rdfs:comment>Relationship between either a pair of qcy:EntityMention or qcy:CanonicalEntity occurrences (never between a qcy:EntityMention and a qcy:CanonicalEntity!). This is a general property that should not be used explicitly. Instead, use one of the more specific sub-properties.</rdfs:comment>
        <rdfs:label xml:lang="en">related entity</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#remoteProviderType">
        <rdfs:comment xml:lang="en">The type of remote provider (ex: gcp, azure, aws, local)</rdfs:comment>
        <rdfs:comment>Relationship that shows in what type of provider is a file stored.</rdfs:comment>
        <rdfs:label xml:lang="en">remote provider type</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#requiresEquipment">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. Relationship between some activity and required equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">requires equipment</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Equipment"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Activity"/>
        <template:extractionPrompt>An &apos;Activity&apos; requires some &apos;Equipment&apos;.</template:extractionPrompt>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#requiresMaterial">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:involves instead. Relationship between some activity and required material.</rdfs:comment>
        <rdfs:label xml:lang="en">requires material</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#ConstructionProcessDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Material"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Activity"/>
        <template:extractionPrompt>An &apos;Activity&apos; requires some &apos;Material&apos;.</template:extractionPrompt>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#siteContainsBuilding">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that indicates that a building belongs to a site.</rdfs:comment>
        <rdfs:label xml:lang="en">site contains building</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Site"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#zoneContainsElement">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that indicates that a building zone contains a building element.</rdfs:comment>
        <rdfs:label xml:lang="en">building zone contains building element</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Site"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Space"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Storey"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#zoneContainsSpace">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains instead. Relationship that indicates that a building zone contains a space.</rdfs:comment>
        <rdfs:label xml:lang="en">zone contains space</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#Space"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Site"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Storey"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#zoneHasAdjacentElement">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:adjacentTo instead. Relationship between a zone/element and an adjacent element.</rdfs:comment>
        <rdfs:label xml:lang="en">zone has adjacent element</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Space"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Storey"/>
    </rdf:Description>
    <rdf:Description rdf:about="https://dev.qaecy.com/ont#zoneHasElement">
        <rdfs:comment>DEPRECATED: This property is outdated. Please use qcy:contains or qcy:adjacentTo instead. Relationship between a zone and a contained or adjacent element.</rdfs:comment>
        <rdfs:label xml:lang="en">zone has element</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <template:applicableContentCategories rdf:resource="https://dev.qaecy.com/enum#DesignDocument"/>
        <template:applicableObjectCategories rdf:resource="https://dev.qaecy.com/enum#BuildingElement"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Building"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Site"/>
        <template:applicableSubjectCategories rdf:resource="https://dev.qaecy.com/enum#Space"/>
